<Application x:Class="Coclico.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Coclico.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Application.Resources>
      <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
              <ui:ThemesDictionary Theme="Dark" />
              <ui:ControlsDictionary />
              <ResourceDictionary Source="/Coclico;component/Resources/Lang/fr.xaml" />
          </ResourceDictionary.MergedDictionaries>

          <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
          <BooleanToVisibilityConverter x:Key="BoolToVis"/>
          <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
          <converters:InverseBoolToVisibilityConverter x:Key="BoolToVisInv"/>
          <converters:FileIconConverter x:Key="FileIconConverter"/>
          <converters:FileIconConverter x:Key="IconConv"/>
          <converters:HexToBrushConverter x:Key="HexToBrush"/>
          <converters:FirstCharConverter x:Key="FirstCharConverter"/>
          <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
          <converters:EqualityToBoolConverter x:Key="EqualityConverter"/>

          <SolidColorBrush x:Key="BgAppBrush" Color="#07080B" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgCardHoverBrush" Color="#1F1A22" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#0A0B0F" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderAccentBrush" Color="#FF5722" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderAccentSecondaryBrush" Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextSidebarBrush" Color="#FAF5F2" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderDefaultLightBrush" Color="#2A2226" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderSubtleLightBrush" Color="#1A161A" po:Freeze="True"/>

          <Color x:Key="AccentPrimary">#FF453A</Color>
          <Color x:Key="AccentSecondary">#FFA000</Color>
          <Color x:Key="AccentCyan">#FF6B35</Color>
          <Color x:Key="AccentCyanLight">#FF9E80</Color>
          <Color x:Key="AccentSuccess">#10B981</Color>

          <sys:Double x:Key="GlobalFontSize">13</sys:Double>
          <sys:Double x:Key="Space4">4</sys:Double>
          <sys:Double x:Key="Space8">8</sys:Double>
          <sys:Double x:Key="Space12">12</sys:Double>
          <sys:Double x:Key="Space16">16</sys:Double>
          <sys:Double x:Key="Space24">24</sys:Double>
          <sys:Double x:Key="Space32">32</sys:Double>
          <sys:Double x:Key="InteractiveMinSize">40</sys:Double>
          <Thickness x:Key="CardPadding">18,16,18,16</Thickness>
          <Thickness x:Key="CardPadding_Compact">12,10,12,10</Thickness>

          <Duration x:Key="AnimFast">0:0:0.10</Duration>
          <Duration x:Key="AnimMed">0:0:0.15</Duration>
          <Duration x:Key="AnimSlow">0:0:0.25</Duration>
          <Duration x:Key="MotionMicro">0:0:0.12</Duration>
          <Duration x:Key="MotionComponent">0:0:0.20</Duration>
          <Duration x:Key="MotionPage">0:0:0.30</Duration>

          <CornerRadius x:Key="CornerCard">10</CornerRadius>
          <CornerRadius x:Key="CornerBtn">8</CornerRadius>
          <CornerRadius x:Key="CornerSmall">6</CornerRadius>
          <CornerRadius x:Key="CornerPill">999</CornerRadius>
          <CornerRadius x:Key="CornerNode">8</CornerRadius>

          <SolidColorBrush x:Key="BgBaseBrush"        Color="#07080B" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgPanelBrush"       Color="#0A0B0F" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgSurfaceBrush"     Color="#0E1016" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgCardBrush"        Color="#13151D" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgElevatedBrush"    Color="#1A1C26" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgHoverBrush"       Color="#222533" po:Freeze="True"/>

          <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#221C20" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderDefaultBrush" Color="#33262B" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderStrongBrush"  Color="#5A3A40" po:Freeze="True"/>

          <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D2CBC6" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextMutedBrush"     Color="#9C928B" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextHintBrush"      Color="#706760" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextAccentBrush"    Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextCyanBrush"      Color="#FF8A50" po:Freeze="True"/>

          <SolidColorBrush x:Key="PrimaryBrush"    Color="#FF453A" po:Freeze="True"/>
          <SolidColorBrush x:Key="SecondaryBrush"  Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FF453A" po:Freeze="True"/>
          <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderAccentPrimaryBrush" Color="#FF5722" po:Freeze="True"/>
          <SolidColorBrush x:Key="SuccessBrush"    Color="#10B981" po:Freeze="True"/>
          <SolidColorBrush x:Key="CyanBrush"       Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="WarnBrush"       Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="DangerBrush"     Color="#FF3B30" po:Freeze="True"/>

          <SolidColorBrush x:Key="ArchitecturalYellowBrush" Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="ArchitecturalAmberBrush"  Color="#FF8A50" po:Freeze="True"/>
          <SolidColorBrush x:Key="ArchitecturalDarkTextBrush" Color="#07080B" po:Freeze="True"/>

          <SolidColorBrush x:Key="NodeStartBrush"   Color="#10B981" po:Freeze="True"/>
          <SolidColorBrush x:Key="NodeActionBrush"  Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="NodeEndBrush"     Color="#FF3B30" po:Freeze="True"/>
          <SolidColorBrush x:Key="NodeCmdBrush"     Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="NodeWaitBrush"    Color="#FF8A50" po:Freeze="True"/>

          <SolidColorBrush x:Key="OverlayLight"      Color="#0AFFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayMid"        Color="#05FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayFaint"      Color="#03FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayDark"       Color="#E607080B" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayDarkStrong" Color="#F207080B" po:Freeze="True"/>

          <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF3B30" Offset="0"/>
              <GradientStop Color="#FF6B35" Offset="0.5"/>
              <GradientStop Color="#FFA000" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="CyberGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#E11D48" Offset="0"/>
              <GradientStop Color="#FF5722" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="PrimaryGradientDiag" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF3B30" Offset="0"/>
              <GradientStop Color="#FFA000" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="FoxGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#E63946" Offset="0"/>
              <GradientStop Color="#FF6B35" Offset="0.5"/>
              <GradientStop Color="#FFA000" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="FoxGradientDiag" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF3B30" Offset="0"/>
              <GradientStop Color="#FF7A00" Offset="0.55"/>
              <GradientStop Color="#FFA000" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="EclipseGlowGradient" StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#33FF5722" Offset="0"/>
              <GradientStop Color="#0007080B" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#059669" Offset="0"/>
              <GradientStop Color="#10B981" Offset="1"/>
          </LinearGradientBrush>

          <SolidColorBrush x:Key="NavGlowBrush" Color="#33FF5722"/>

          <LinearGradientBrush x:Key="GradHome" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2563EB" Offset="0"/>
              <GradientStop Color="#4F46E5" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradRam" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#6366F1" Offset="0"/>
              <GradientStop Color="#8B5CF6" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradCleaning" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#059669" Offset="0"/>
              <GradientStop Color="#10B981" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradPrograms" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#D97706" Offset="0"/>
              <GradientStop Color="#F59E0B" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradInstaller" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0284C7" Offset="0"/>
              <GradientStop Color="#38BDF8" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradHealth" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#4338CA" Offset="0"/>
              <GradientStop Color="#6366F1" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradNetwork" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#BE123C" Offset="0"/>
              <GradientStop Color="#F43F5E" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradSettings" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#475569" Offset="0"/>
              <GradientStop Color="#64748B" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradHelp" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0891B2" Offset="0"/>
              <GradientStop Color="#06B6D4" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradAi" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#7C3AED" Offset="0"/>
              <GradientStop Color="#EC4899" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradZen" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0369A1" Offset="0"/>
              <GradientStop Color="#38BDF8" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradGamer" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#9F1239" Offset="0"/>
              <GradientStop Color="#F43F5E" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradWork" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#065F46" Offset="0"/>
              <GradientStop Color="#10B981" Offset="1"/>
          </LinearGradientBrush>

          <CubicEase   x:Key="EaseOut"        EasingMode="EaseOut"/>
          <CubicEase   x:Key="EaseIn"         EasingMode="EaseIn"/>
          <CubicEase   x:Key="EaseInOut"      EasingMode="EaseInOut"/>
          <BackEase    x:Key="EaseBack"       EasingMode="EaseOut" Amplitude="0.25"/>
          <BackEase    x:Key="SpringEaseOut"  EasingMode="EaseOut" Amplitude="0.28"/>
          <BackEase    x:Key="SpringBounce"   EasingMode="EaseOut" Amplitude="0.35"/>
          <QuarticEase x:Key="SmoothEaseOut"  EasingMode="EaseOut"/>

          <SolidColorBrush x:Key="AccentBrush"   Color="#FF453A" po:Freeze="True"/>
          <SolidColorBrush x:Key="WarningBrush"  Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="FocusBrush" Color="#FF6B35" po:Freeze="True"/>

          <Style x:Key="RedSunPillBadge" TargetType="Border">
              <Setter Property="Background" Value="#22FF5722"/>
              <Setter Property="BorderBrush" Value="#88FF6B35"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerPill}"/>
              <Setter Property="Padding" Value="12,4"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="RedSunCard" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding" Value="18,16"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="RedSunPrimaryButton" TargetType="Button">
              <Setter Property="Background" Value="{DynamicResource PrimaryGradient}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="18,9"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="border"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{StaticResource CornerPill}"
                                  Padding="{TemplateBinding Padding}">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                  <Setter TargetName="border" Property="Opacity" Value="0.80"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="CoclicoPanel" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="CoclicoPageTitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="24"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="Margin" Value="0,0,0,4"/>
          </Style>

          <Style x:Key="CoclicoMetaText" TargetType="TextBlock">
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              <Setter Property="TextWrapping" Value="Wrap"/>
          </Style>

          <Style x:Key="CoclicoStatusBadge" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerPill}"/>
              <Setter Property="Padding" Value="8,4"/>
          </Style>

          <Style x:Key="SubtleCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding"         Value="{DynamicResource CardPadding}"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="ElevatedCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderStrongBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding"         Value="{DynamicResource CardPadding}"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="GlowCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderAccentBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding" Value="18,16"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="TerminalCard" TargetType="Border">
              <Setter Property="Background"      Value="#07090E"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerSmall}"/>
              <Setter Property="Padding"         Value="14,10"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="PremiumCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderAccentBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding"         Value="{DynamicResource CardPadding}"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="AnimatedCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding"         Value="{DynamicResource CardPadding}"/>
              <Setter Property="Cursor"          Value="Hand"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="SectionLabel" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="9.5"/>
              <Setter Property="FontWeight" Value="Black"/>
              <Setter Property="Foreground" Value="{DynamicResource TextHintBrush}"/>
              <Setter Property="Margin"     Value="2,0,0,14"/>
              <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
          </Style>

          <Style x:Key="SectionTitle" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="16"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="Margin"     Value="0,0,0,4"/>
          </Style>

          <Style x:Key="DescText" TargetType="TextBlock">
              <Setter Property="FontSize"      Value="12"/>
              <Setter Property="Foreground"    Value="{DynamicResource TextSecondaryBrush}"/>
              <Setter Property="TextWrapping"  Value="Wrap"/>
              <Setter Property="LineHeight"    Value="18"/>
          </Style>

          <Style TargetType="TextBlock">
              <Setter Property="FontSize"   Value="{DynamicResource GlobalFontSize}"/>
              <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"/>
              <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
              <Setter Property="RenderOptions.ClearTypeHint"  Value="Enabled"/>
          </Style>

          <Style x:Key="PrimaryButton" TargetType="Button">
              <Setter Property="Cursor"                     Value="Hand"/>
              <Setter Property="Foreground"                 Value="#0A0A0C"/>
              <Setter Property="FontWeight"                 Value="Bold"/>
              <Setter Property="FontSize"                   Value="12.5"/>
              <Setter Property="Padding"                    Value="16,8"/>
              <Setter Property="BorderThickness"            Value="0"/>
              <Setter Property="SnapsToDevicePixels"        Value="True"/>
              <Setter Property="RenderTransformOrigin"      Value="0.5,0.5"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{DynamicResource PrimaryGradient}"
                                  CornerRadius="{StaticResource CornerBtn}"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="True">
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                              </Trigger>
                              <EventTrigger RoutedEvent="Button.MouseEnter">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.025" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.025" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.MouseLeave">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.96" Duration="0:0:0.07"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.96" Duration="0:0:0.07"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="ArchitecturalActionCard" TargetType="Button">
              <Setter Property="Cursor"                     Value="Hand"/>
              <Setter Property="Foreground"                 Value="#0A0A0C"/>
              <Setter Property="FontWeight"                 Value="Bold"/>
              <Setter Property="BorderThickness"            Value="0"/>
              <Setter Property="SnapsToDevicePixels"        Value="True"/>
              <Setter Property="RenderTransformOrigin"      Value="0.5,0.5"/>
              <Setter Property="Background"                 Value="{DynamicResource ArchitecturalYellowBrush}"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="8"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="True">
                              <Border.Effect>
                                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#FFC700" Opacity="0.25"/>
                              </Border.Effect>
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="#FFD633"/>
                              </Trigger>
