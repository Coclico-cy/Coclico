<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icone\plage.ico</ApplicationIcon>
    <Company>Coclico</Company>
    <Product>Coclico</Product>
    <Description>Windows desktop application for system information and maintenance tools.</Description>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Coclico</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>

    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icone\plage.ico" />
    <Resource Include="Resources\icone\plage.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Coclico.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.26.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.26.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />

    <PackageReference Include="System.Reactive" Version="6.0.1" />

    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeCuda)' == 'true'">
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.26.0" />
    <PackageReference Include="NtvLibs.cuda12.cudart64_12.runtime.win-x64" Version="12.8.1" />
    <PackageReference Include="NtvLibs.cuda12.cublas.runtime.win-x64" Version="12.8.1" />
  </ItemGroup>

  <Target Name="RemoveNonWindowsRuntimeAssetsFromWindowsPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)runtimes\linux-x64" />
  </Target>

</Project>