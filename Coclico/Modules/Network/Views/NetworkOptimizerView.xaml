<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Coclico.Views.NetworkOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}"
             d:DesignHeight="950" d:DesignWidth="1250">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="22" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Network_Title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Network_Subtitle}" FontSize="11.5" Margin="14,6,0,0"
                               Foreground="{DynamicResource TextHintBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="12" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Network_LivePingLabel}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LivePingText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="12" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Network_LiveDownloadLabel}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LiveDownloadText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Network_AdapterTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButtonStyle}"
                                Padding="10,6" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnRefresh}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ComboBox ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              IsEnabled="{Binding IsNotBusy}"
                              Background="{DynamicResource BgElevatedBrush}"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Padding="8,6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding TypeIcon}" FontSize="12" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpeedDisplay}" Foreground="{DynamicResource TextHintBrush}"
                                               FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid x:Name="AdapterInfoGrid" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Network_AdapterDriver}" FontSize="9.5" Foreground="{DynamicResource TextHintBrush}"/>
                            <TextBlock Text="{Binding SelectedAdapter.DriverDescription}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Network_AdapterIp}" FontSize="9.5" Foreground="{DynamicResource TextHintBrush}"/>
                            <TextBlock Text="{Binding SelectedAdapter.IPv4Address}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Network_AdapterGateway}" FontSize="9.5" Foreground="{DynamicResource TextHintBrush}"/>
                            <TextBlock Text="{Binding SelectedAdapter.GatewayAddress}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Network_ActionsTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    </StackPanel>

                    <WrapPanel>
                        <Button Command="{Binding AutoTestedCommand}" Style="{StaticResource ActionButtonStyle}"
                                Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                                ToolTip="{DynamicResource Network_BtnAutoTestedTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="{DynamicResource ArchitecturalDarkTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnAutoTested}" Foreground="{DynamicResource ArchitecturalDarkTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FullTuningCommand}" Style="{StaticResource ActionButtonStyle}"
                                ToolTip="{DynamicResource Network_BtnFullTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Rocket24" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnFull}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RunTestCommand}" Style="{StaticResource ActionButtonStyle}"
                                ToolTip="{DynamicResource Network_BtnTestTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnTest}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RestoreCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0"
                                ToolTip="{DynamicResource Network_BtnRestoreTip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnRestore}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_BtnCancel}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="4"
                                    Background="{DynamicResource BgElevatedBrush}"
                                    Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                    BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Network_ResultsTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Network_ColBefore}" Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Network_ColAfter}" Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Network_ColDelta}" Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Network_MetricDownload}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownloadBeforeText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DownloadAfterText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DownloadDeltaText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{Binding DownloadDeltaColor, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Network_MetricUpload}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UploadBeforeText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding UploadAfterText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding UploadDeltaText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{Binding UploadDeltaColor, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Network_MetricLatency}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LatencyBeforeText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LatencyAfterText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding LatencyDeltaText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{Binding LatencyDeltaColor, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Network_MetricJitter}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding JitterBeforeText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding JitterAfterText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding JitterDeltaText}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{Binding JitterDeltaColor, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Network_ParamsTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding TuningParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border Background="#2A2E36" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CurrentToTarget}" FontSize="10.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOptimal}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrush}}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Network_LogTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    </StackPanel>
                    <ListBox x:Name="OutputListBox" ItemsSource="{Binding OutputLog}" Height="170"
                            Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            FontFamily="Consolas" FontSize="10.5"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
