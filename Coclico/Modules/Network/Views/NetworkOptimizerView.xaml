<UserControl x:Class="Coclico.Views.NetworkOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Coclico.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}"
             d:DesignHeight="950" d:DesignWidth="1250">

    <UserControl.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityConverter"/>

        <Style x:Key="TabNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#071014"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopeFilterStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                Background="{DynamicResource BgElevatedBrush}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopeFilterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                Background="{DynamicResource BgElevatedBrush}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetCardStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1A6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#256366F1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{DynamicResource TextHintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Network_HeaderBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Network_Title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Border CornerRadius="8" Padding="10,6" Margin="0,0,6,0"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Network_LivePing}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LivePing, StringFormat='{}{0:F1} ms'}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="10,6" Margin="0,0,6,0"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="#60A5FA" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Network_LiveThroughput}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LiveThroughputDisplay}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Padding="10,6" Margin="0,0,8,0"
                        Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Network_WatchdogActive}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding RefreshAdaptersCommand}"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" Padding="8" Cursor="Hand" ToolTip="{DynamicResource Network_RefreshAdapters}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Network_AdaptersTitle}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Network_AdaptersSubtitle}"
                               FontSize="10" Foreground="{DynamicResource TextHintBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Adapters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="AdapterGroup" Margin="0,0,8,4"
                                         Click="AdapterRadio_Click"
                                         Style="{StaticResource PresetCardStyle}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                        <Binding Path="." />
                                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.SelectedAdapter" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <Grid MinWidth="210">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                            Background="{DynamicResource BgElevatedBrush}" Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="{Binding TypeIcon}" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Network_AdapterActive}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SpeedDisplay, StringFormat='Vitesse : {0}'}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding IPv4Address, StringFormat='IP : {0}'}" FontSize="9.5"
                                                   Foreground="{DynamicResource TextHintBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="6,4" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabNavStyle}" Content="{DynamicResource Network_TabAutoOpt}"
                             IsChecked="{Binding IsLaboratoireTab}" Click="TabLaboratoire_Click"
                             ToolTip="{DynamicResource Network_TabAutoOpt_Tip}"/>
                <RadioButton Style="{StaticResource TabNavStyle}" Content="{DynamicResource Network_TabAdvanced}"
                             IsChecked="{Binding IsMatrixTab}" Click="TabMatrix_Click"
                             ToolTip="{DynamicResource Network_TabAdvanced_Tip}"/>
                <RadioButton Style="{StaticResource TabNavStyle}" Content="{DynamicResource Network_TabStats}"
                             IsChecked="{Binding IsResultsTab}" Click="TabResults_Click"
                             ToolTip="{DynamicResource Network_TabStats_Tip}"/>
                <RadioButton Style="{StaticResource TabNavStyle}" Content="{DynamicResource Network_TabLogs}"
                             IsChecked="{Binding IsLogsTab}" Click="TabLogs_Click"
                             ToolTip="{DynamicResource Network_TabLogs_Tip}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Visibility="{Binding IsLaboratoireTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <Border CornerRadius="12" Padding="16,14" Margin="0,0,4,10"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="#1A2563EB" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Network_GlobalOptimizerTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Network_GlobalOptimizerDesc}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource Network_HeaderExecutionMode}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <RadioButton GroupName="UnifiedExecutionMode" Content="{DynamicResource Network_ModeSafeBtn}"
                                             IsChecked="{Binding IsSafeMode}" Click="ModeSafe_Click" Style="{StaticResource ModeCardStyle}"/>
                                <RadioButton GroupName="UnifiedExecutionMode" Content="{DynamicResource Network_ModeExpertBtn}"
                                             IsChecked="{Binding IsExpertMode}" Click="ModeExpert_Click" Style="{StaticResource ModeCardStyle}"/>
                            </UniformGrid>

                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ModeTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ModeDescription}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Network_HeaderTargetProfile}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,8">
                                <RadioButton GroupName="CognitiveProfileGroup" Content="{DynamicResource Network_PresetGaming}"
                                             IsChecked="True" Click="ProfileGaming_Click" Style="{StaticResource ModeCardStyle}"/>
                                <RadioButton GroupName="CognitiveProfileGroup" Content="{DynamicResource Network_PresetLowLatency}"
                                             Click="ProfileLowLatency_Click" Style="{StaticResource ModeCardStyle}"/>
                                <RadioButton GroupName="CognitiveProfileGroup" Content="{DynamicResource Network_PresetMaxThroughput}"
                                             Click="ProfileThroughput_Click" Style="{StaticResource ModeCardStyle}"/>
                                <RadioButton GroupName="CognitiveProfileGroup" Content="{DynamicResource Network_PresetBalanced}"
                                             Click="ProfileBalanced_Click" Style="{StaticResource ModeCardStyle}"/>
                            </WrapPanel>

                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <ui:SymbolIcon Symbol="Target24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ProfileTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProfileDescription}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Network_HeaderIncludedOptimizations}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Network_FeatureDns}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Network_FeatureDns_Desc}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="19,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Network_FeatureMtu}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Network_FeatureMtu_Desc}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="19,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,4,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Network_FeatureTcp}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Network_FeatureTcp_Desc}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="19,1,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,4,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Network_FeatureQos}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Network_FeatureQos_Desc}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="19,1,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding RunCognitiveOptimizationCommand}"
                                        Height="42" Background="{DynamicResource PrimaryBrush}" BorderThickness="0"
                                        Cursor="Hand" FontWeight="Bold" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Network_LaunchGlobalOpt}" Foreground="White" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding RollbackEmergencyCommand}"
                                        Height="42" Background="{DynamicResource BgElevatedBrush}" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" Cursor="Hand"
                                        IsEnabled="{Binding IsNotBusy}" ToolTip="{DynamicResource Network_RestoreInitial_Tip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Network_RestoreInitial}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                    Height="36" Background="#26EF4444" BorderBrush="#80EF4444" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Network_StopBenchmark}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,2,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding RestoreDefaultsCommand}"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="10,6" Cursor="Hand" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Network_DefaultSettings}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding BenchmarkDnsCommand}"
                                        Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="10,6" Cursor="Hand" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Network_TestDns}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4" Command="{Binding DetectMtuCommand}"
                                        Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Padding="10,6" Cursor="Hand" IsEnabled="{Binding IsNotBusy}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Network_DetectMtu}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" CornerRadius="12" Padding="16,14"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="MESURES EN DIRECT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="6" Padding="8,3" Background="#1A6366F1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding LiveExperimentRatio}" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC"/>
                            </Border>
                            <Border CornerRadius="6" Padding="8,3" Background="#1A10B981"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding LiveEstimatedTimeRemaining}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding EngineProgress.PhaseDescription, FallbackValue={StaticResource Network_WaitingStart}}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="7"
                                     Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BgElevatedBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                            Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Background="#1A6366F1">
                                        <TextBlock Text="{Binding LiveCurrentParameterScope}" FontSize="9.5" FontWeight="Bold" Foreground="#A5B4FC"/>
                                    </Border>
                                    <TextBlock Text="{Binding LiveCurrentParameterName}" FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="{DynamicResource BgCardBrush}">
                                    <TextBlock Text="{Binding LiveCurrentParameterCategory}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <ui:SymbolIcon Symbol="Lightbulb24" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,1,6,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding LiveCurrentParameterExplanation}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15"/>
                            </StackPanel>

                            <Border CornerRadius="6" Padding="8,3" Background="#12000000" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{Binding LiveDecisionTrendColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding LiveDecisionTrendText}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{Binding LiveDecisionTrendColorHex, Converter={StaticResource HexToBrush}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="3" CornerRadius="6" Padding="8,5" Margin="0,0,0,8"
                                Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#60A5FA" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding LiveCurrentTestName}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LiveSamplesRatio}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#BFDBFE" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Network_MetricLatency}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LivePrecisionLatencyMs, StringFormat='{}{0:F1} ms'}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <Border CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" Background="#15000000" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveLatencyDeltaText}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding LiveLatencyDeltaColorHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Network_MetricJitter}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LivePrecisionJitterMs, StringFormat='{}{0:F1} ms'}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                <Border CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" Background="#15000000" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveJitterDeltaText}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding LiveJitterDeltaColorHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="10" Padding="12,8"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Network_MetricSpeed}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LivePrecisionThroughputMbps, StringFormat='{}{0:F1} Mbps'}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                <Border CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" Background="#15000000" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveThroughputDeltaText}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding LiveThroughputDeltaColorHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" CornerRadius="10" Padding="12,8"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="TopSpeed24" FontSize="13" Foreground="#818CF8" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Network_MetricBufferbloat}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LivePrecisionBufferbloatMs, StringFormat='{}{0:F1} ms'}"
                                           FontSize="17" FontWeight="Bold" Foreground="#A5B4FC" HorizontalAlignment="Center"/>
                                <Border CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" Background="#15000000" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveBufferbloatDeltaText}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding LiveBufferbloatDeltaColorHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                            Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Visibility="{Binding HasCompletedSession, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Network_WatchdogDecisions}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding LiveRecentDecisions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ParameterDisplayName}" FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DecisionReason}" FontSize="8.5" Foreground="{DynamicResource TextHintBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" CornerRadius="3" Padding="5,1" Background="{Binding DecisionColorHex, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding DecisionDisplay}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="5" CornerRadius="8" Padding="10,8" Background="#1410B981" BorderBrush="#3310B981" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Network_WatchdogActive}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Network_WatchdogDesc}"
                                           FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource Network_TabAdvanced}" Style="{StaticResource ScopeFilterButtonStyle}"
                                    Click="TabMatrix_Click" Padding="8,4" FontSize="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding IsMatrixTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding ParameterSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,7" FontSize="11.5"
                             Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                             BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}"
                             ToolTip="{DynamicResource Network_MatrixSearchPrompt}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="{DynamicResource Network_FilterAll}" Style="{StaticResource ScopeFilterStyle}"
                                     IsChecked="True" Click="ScopeAll_Click"/>
                        <RadioButton Content="{DynamicResource Network_FilterNdis}" Style="{StaticResource ScopeFilterStyle}"
                                     Click="ScopeNdis_Click"/>
                        <RadioButton Content="{DynamicResource Network_FilterTcp}" Style="{StaticResource ScopeFilterStyle}"
                                     Click="ScopeTcp_Click"/>
                        <RadioButton Content="{DynamicResource Network_FilterQos}" Style="{StaticResource ScopeFilterStyle}"
                                     Click="ScopeQos_Click"/>
                        <RadioButton Content="MTU &amp; Trame" Style="{StaticResource ScopeFilterStyle}"
                                     Click="ScopeMtu_Click"/>
                        <RadioButton Content="{DynamicResource Network_FilterIpv6}" Style="{StaticResource ScopeFilterStyle}"
                                     Click="ScopeIpv6_Click"/>
                    </StackPanel>

                    <Border Grid.Column="4" CornerRadius="6" Padding="10,4" Background="#1A6366F1">
                        <TextBlock Text="{Binding FilteredExperiments.Count, StringFormat='{}{0} paramètres listés'}"
                                   FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="10" Padding="10,8"
                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredExperiments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,6"
                                        Background="{DynamicResource BgElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                        Background="{Binding ScopeColorHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding ParameterScope}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>

                                                <TextBlock Text="{Binding ParameterDisplayName}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                <TextBlock Text="{Binding ParameterKeyword, StringFormat=' ({0})'}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextHintBrush}" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                    Background="{Binding DecisionColorHex, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding DecisionDisplay}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,6">
                                            <TextBlock Text="{DynamicResource Network_DetailUsage}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding ParameterExplanation}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Row="2" CornerRadius="6" Padding="8,4" Background="{DynamicResource BgCardBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{DynamicResource Network_DetailValue}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding OriginalValue}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0"/>
                                                    <TextBlock Text="{Binding TestedValue}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Background="#156366F1" Margin="0,0,16,0">
                                                    <TextBlock Text="{DynamicResource Network_DetailProtocol}" FontSize="9" FontWeight="SemiBold" Foreground="#A5B4FC"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Network_DetailImpact}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding ImpactBadgeText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="4" Text="{Binding DecisionReason}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextHintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding IsResultsTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Network_ReportTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CopyResultsSummaryCommand}"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="10,5" Cursor="Hand" Margin="0,0,10,0" ToolTip="{DynamicResource Network_CopyReport_Tip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Network_CopyReport}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Border CornerRadius="6" Padding="10,4" Background="#1A10B981" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Network_ReportValidatedTweaks}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ValidatedTweaksCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="6" Padding="10,4" Background="#1AF59E0B" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Network_ReportRejectedRegressions}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RevertedTweaksCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="6" Padding="10,4" Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Network_ReportTotalEvaluated}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TotalTestedParametersCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Network_ReportPingLatency}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock Text="{Binding BaselinePingDisplay}" FontSize="12.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalPingDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding FinalPingProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,3,0,4"
                                     Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource BgElevatedBrush}"/>
                        <Border CornerRadius="4" Padding="6,2" Background="#1A10B981" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PingGainDisplay, StringFormat='Gain : {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Network_ReportJitter}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock Text="{Binding BaselineJitterDisplay}" FontSize="12.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalJitterDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding FinalJitterProgress, Mode=OneWay, FallbackValue=25}" Maximum="100" Height="4" Margin="0,3,0,4"
                                     Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource BgElevatedBrush}"/>
                        <Border CornerRadius="4" Padding="6,2" Background="#1AF59E0B" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportSmoothFlow}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Network_ReportRealSpeed}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock Text="{Binding BaselineThroughputDisplay}" FontSize="11.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalThroughputDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding FinalThroughputProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,3,0,4"
                                     Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource BgElevatedBrush}"/>
                        <Border CornerRadius="4" Padding="6,2" Background="#1A10B981" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ThroughputGainDisplay, StringFormat='Gain : {0}'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Network_ReportBufferbloat}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock Text="{Binding BaselineBufferbloatDisplay, StringFormat='Grade {0}'}" FontSize="12.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="#A5B4FC" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalBufferbloatDisplay, StringFormat='Grade {0}'}" FontSize="18" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="90" Maximum="100" Height="4" Margin="0,3,0,4"
                                     Foreground="#A5B4FC" Background="{DynamicResource BgElevatedBrush}"/>
                        <Border CornerRadius="4" Padding="6,2" Background="#1A6366F1" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportZeroLag}" FontSize="9.5" FontWeight="Bold" Foreground="#A5B4FC"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Network_ReportGlobalScore}" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <TextBlock Text="{Binding BaselineScoreDisplay}" FontSize="11.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalScoreDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding FinalScoreProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,3,0,4"
                                     Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BgElevatedBrush}"/>
                        <Border CornerRadius="4" Padding="6,2" Background="#1A6366F1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ScoreGainDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.8*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Trophy24" FontSize="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="MEILLEURS RÉGLAGES RETENUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding TopImprovements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="8"
                                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ParameterDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DecisionReason}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="13"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="#1A10B981" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ImpactBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Padding="14,12"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="15" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Network_ReportSecurityTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Network_ReportSecurityDesc}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,8"/>
                            <Border CornerRadius="6" Padding="10,6" Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Network_ReportBlockedRisks}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding RevertedTweaksCount, StringFormat='{}{0} rejetés'}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="10" Padding="16,14"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Network_ReportNarrativeTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding CopyResultsSummaryCommand}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource Common_Copy}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding StorytellingReport, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="11.5" FontFamily="Segoe UI, sans-serif"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding IsLogsTab, Converter={StaticResource BoolToVis}}">
            <Border CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Network_LogsTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Button Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Right" Padding="10,3" Content="{DynamicResource Common_Stop}" FontSize="10.5" Cursor="Hand"
                                Background="#26EF4444" Foreground="{DynamicResource DangerBrush}" BorderBrush="#80EF4444"/>
                    </Grid>

                    <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent}" Maximum="100" Height="4"
                                 Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer x:Name="ConsoleScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutputLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10.5" FontFamily="Consolas, monospace"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1.5" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>