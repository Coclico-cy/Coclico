<Window x:Class="Coclico.Views.NetworkResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource NetworkResults_Title}" Height="540" Width="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseDown="Window_MouseDown">
    <Border Margin="12" Background="{DynamicResource BgBaseBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Height="2" VerticalAlignment="Top" Margin="18,0" CornerRadius="1"
                    Background="{DynamicResource ArchitecturalYellowBrush}"/>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#10B981"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource NetworkResults_Header}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource NetworkResults_Subheader}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="Close_Click" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand" Padding="6"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,14" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSimple" Content="{DynamicResource NetworkResults_SimpleView}" IsChecked="True"
                                 Checked="TabSimple_Checked" GroupName="ResultMode"
                                 Style="{StaticResource GhostButton}" Padding="12,5" FontSize="11" FontWeight="Bold"/>
                    <RadioButton x:Name="TabExpert" Content="{DynamicResource NetworkResults_ExpertView}"
                                 Checked="TabExpert_Checked" GroupName="ResultMode"
                                 Style="{StaticResource GhostButton}" Padding="12,5" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" x:Name="PanelSimple" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportPingLatency}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalYellowBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource NetworkResults_IncreasedResponsiveness}" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportJitter}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalAmberBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtJitter" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource NetworkResults_SmoothTraffic}" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportRealSpeed}" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtThroughput" Text="-- Mbps" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource NetworkResults_MaxBandwidth}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Network_ReportBufferbloat}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtBufferbloat" Text="{DynamicResource NetworkResults_Grade}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource NetworkResults_NoLagUnderLoad}" FontSize="9" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="14"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NetworkResults_AppliedSummary}" FontSize="10" FontWeight="Black"
                                       Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtSummary"
                                       Text="{DynamicResource NetworkResults_AppliedDesc}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" x:Name="PanelExpert" Visibility="Collapsed">
                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="10"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NetworkResults_ExperimentsTable}" FontSize="10" FontWeight="Black"
                                       Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ListExperiments">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="6"
                                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Padding="5,2" Margin="0,0,8,0"
                                                        Background="{DynamicResource BgSurfaceBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ParameterCategory}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ParameterDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="{Binding DecisionReason}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{Binding DecisionBadgeBg}">
                                                    <TextBlock Text="{Binding AppliedValue}" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{Binding DecisionBadgeFg}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Button Click="Copy_Click" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="14,8" Cursor="Hand" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Network_CopyReport}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Padding="24,8" Click="Close_Click">
                    <TextBlock Text="{DynamicResource Common_Done}" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>