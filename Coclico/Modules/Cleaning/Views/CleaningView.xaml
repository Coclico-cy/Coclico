<UserControl x:Class="Coclico.Views.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}" d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>

        <Style x:Key="CleanModeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter Property="Foreground" Value="#0A0A0C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot" Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{DynamicResource TextHintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Cleaning_HeaderBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Cleaning_Title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    <Border Margin="14,0,0,0" Padding="10,3" CornerRadius="6"
                            Background="#1AFFC700" BorderBrush="#33FFC700" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Cleaning_Cleanable}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding TotalCleanableText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{DynamicResource Cleaning_Subtitle}"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ArchitecturalActionCard}" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Padding="16,8" ToolTip="{DynamicResource Cleaning_ScanTooltip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Cleaning_ScanBtn}" FontSize="11.5" FontWeight="Bold" Foreground="#0A0A0C" VerticalAlignment="Center"/>
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" Foreground="#0A0A0C" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="12,8" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Cleaning_Mode}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>

                <Border Grid.Column="1" Background="{DynamicResource BgPanelBrush}"
                        CornerRadius="9" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource CleanModeTabStyle}" Content="{DynamicResource Cleaning_PresetQuick}"
                                     IsChecked="{Binding IsPresetQuick, Mode=OneWay}"
                                     Command="{Binding SelectPresetCommand}" CommandParameter="Quick"
                                     GroupName="CleanPresets" Margin="0,0,2,0"
                                     ToolTip="{DynamicResource Cleaning_ProfileQuick_Tip}"/>
                        <RadioButton Style="{StaticResource CleanModeTabStyle}" Content="{DynamicResource Cleaning_PresetRecommended}"
                                     IsChecked="{Binding IsPresetRecommended, Mode=OneWay}"
                                     Command="{Binding SelectPresetCommand}" CommandParameter="Recommended"
                                     GroupName="CleanPresets" Margin="0,0,2,0"
                                     ToolTip="{DynamicResource Cleaning_ProfileRecommended_Tip}"/>
                        <RadioButton Style="{StaticResource CleanModeTabStyle}" Content="{DynamicResource Cleaning_PresetDeep}"
                                     IsChecked="{Binding IsPresetDeep, Mode=OneWay}"
                                     Command="{Binding SelectPresetCommand}" CommandParameter="Deep"
                                     GroupName="CleanPresets" Margin="0,0,2,0"
                                     ToolTip="{DynamicResource Cleaning_ProfileDeep_Tip}"/>
                        <RadioButton Style="{StaticResource CleanModeTabStyle}" Content="{DynamicResource Cleaning_PresetCustom}"
                                     IsChecked="{Binding IsPresetCustom, Mode=OneWay}"
                                     Command="{Binding SelectPresetCommand}" CommandParameter="Custom"
                                     GroupName="CleanPresets"
                                     ToolTip="{DynamicResource Cleaning_ProfileCustom_Tip}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}"
                            Padding="10,4" Margin="0,0,6,0">
                        <TextBlock Text="{DynamicResource Cleaning_SelectAll}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding DeselectAllCommand}"
                            Padding="10,4">
                        <TextBlock Text="{DynamicResource Cleaning_DeselectAll}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">

            <Grid x:Name="DustOverlay" Panel.ZIndex="10" IsHitTestVisible="False"
                  Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,20" Width="14" Height="14" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8010B981" Offset="0"/>
                            <GradientStop Color="#0010B981" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust1T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Dust1T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-120" Duration="0:0:2.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.75" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,30" Width="10" Height="10" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#806366F1" Offset="0"/>
                            <GradientStop Color="#006366F1" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust2T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.4">
                                    <DoubleAnimation Storyboard.TargetName="Dust2T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-100" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.65" Duration="0:0:0.4" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,10" Width="18" Height="18" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8038BDF8" Offset="0"/>
                            <GradientStop Color="#0038BDF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust3T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.8">
                                    <DoubleAnimation Storyboard.TargetName="Dust3T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-140" Duration="0:0:2.5"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.8" Duration="0:0:0.6" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,15" Width="12" Height="12" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80F59E0B" Offset="0"/>
                            <GradientStop Color="#00F59E0B" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust4T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.2">
                                    <DoubleAnimation Storyboard.TargetName="Dust4T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-90" Duration="0:0:1.6"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.7" Duration="0:0:0.4" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,25" Width="8" Height="8" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80EF4444" Offset="0"/>
                            <GradientStop Color="#00EF4444" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust5T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.6">
                                    <DoubleAnimation Storyboard.TargetName="Dust5T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-110" Duration="0:0:2.0"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.6" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Ellipse Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,10" Width="16" Height="16" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8010B981" Offset="0"/>
                            <GradientStop Color="#0010B981" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dust6T"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:2.0">
                                    <DoubleAnimation Storyboard.TargetName="Dust6T"
                                                     Storyboard.TargetProperty="Y"
                                                     From="0" To="-130" Duration="0:0:2.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="0.75" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>

            <Border CornerRadius="12" Padding="8"
                    Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border x:Name="CatCard" CornerRadius="8" Margin="4,3" Padding="10,8"
                                        Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"/>

                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7" Margin="0,0,10,0"
                                                Background="{DynamicResource BgElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Icon}" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                <Border Margin="7,0,0,0" Padding="4,1" CornerRadius="4"
                                                        Background="#267C3AED"
                                                        Visibility="{Binding IsDeep, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{DynamicResource Cleaning_ModeDeep}" FontSize="8.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                                Background="{DynamicResource BgElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding SizeText}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextAccentBrush}"
                                                       FontFamily="Consolas, Courier New"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CatCard" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Setter TargetName="CatCard" Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" CornerRadius="12" Padding="18,14"
                Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ProgressBar Margin="0,6,0,0" Height="5" BorderThickness="0"
                                 Background="#1AFFFFFF" Foreground="{DynamicResource PrimaryBrush}"
                                 Value="{Binding Progress}"
                                 Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Margin="0,6,0,0" Height="5" BorderThickness="0"
                                 Background="#1AFFFFFF" Foreground="{DynamicResource PrimaryBrush}"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,10,0" Padding="16,10">
                        <TextBlock Text="{DynamicResource Cleaning_Cancel}" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}"
                            IsEnabled="{Binding IsNotBusy}" Padding="24,12" Height="46">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CleanButtonText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>