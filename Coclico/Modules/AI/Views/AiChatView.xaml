<UserControl x:Class="Coclico.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="490"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             AllowDrop="True" Drop="UserControl_Drop">

    <UserControl.Resources>
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryGradient}"/>
            <Setter Property="CornerRadius" Value="14,14,2,14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Margin" Value="50,4,8,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="AiBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="14,14,14,2"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="Margin" Value="6,4,50,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ActionChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource BgBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="14,10"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource BgCardBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{DynamicResource PrimaryGradient}"
                                    Margin="0,0,10,0">
                                <ui:SymbolIcon Symbol="Bot24" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Ai_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtStatusSubtitle" Text="{DynamicResource Ai_Status_Ready}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnUnloadModel" Click="BtnUnloadModel_Click"
                                    Background="Transparent" BorderThickness="0" Padding="5" Margin="0,0,3,0" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_Unload_Tip}">
                                <ui:SymbolIcon Symbol="Memory16" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="BtnReset" Click="BtnReset_Click"
                                    Background="Transparent" BorderThickness="0" Padding="5" Margin="0,0,3,0" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_Reset_Tip}">
                                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="BtnClose" Click="BtnClose_Click"
                                    Background="Transparent" BorderThickness="0" Padding="5" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_Close_Tip}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="2" Margin="0,0,8,0">
                            <Button x:Name="BtnMasterToggle" Click="BtnMasterToggle_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8,3" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_MasterToggle_Tip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="DotMasterStatus" Width="7" Height="7" CornerRadius="4"
                                            Background="#22C55E" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtMasterStatus" Text="{DynamicResource Ai_Master_Active}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border x:Name="HardwarePill" Grid.Column="1" CornerRadius="12" Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="2">
                            <Button x:Name="BtnHardwareToggle" Click="BtnHardwareToggle_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8,3" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_HardwareToggle_Tip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHardwareIcon" Text="⚡" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtHardwareMode" Text="GPU" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border x:Name="AutoExecPill" Grid.Column="2" HorizontalAlignment="Right" CornerRadius="12"
                                Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="2">
                            <Button x:Name="BtnAutoExecToggle" Click="BtnAutoExecToggle_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8,3" Cursor="Hand"
                                    ToolTip="{DynamicResource Ai_AutoExecToggle_Tip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAutoExecIcon" Text="🛡️" FontSize="10.5" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TxtAutoExecMode" Text="{DynamicResource Ai_AutoExec_Confirm}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbProvider" Grid.Column="0"
                                  SelectionChanged="CmbProvider_SelectionChanged"
                                  DisplayMemberPath="Label" SelectedValuePath="Provider"
                                  FontSize="11" Height="34" MinHeight="32"
                                  Padding="8,4" VerticalContentAlignment="Center"/>

                        <ComboBox x:Name="CmbModel" Grid.Column="2"
                                  SelectionChanged="CmbModel_SelectionChanged"
                                  FontSize="11" Height="34" MinHeight="32"
                                  Padding="8,4" VerticalContentAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1">

                <Border x:Name="BannerDisabledState"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="14,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Ai_Standby_Title}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                            <TextBlock Text="{DynamicResource Ai_Standby_Desc}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Ai_Standby_WakeUp}"
                                FontSize="10.5" Height="26" Padding="10,0"
                                Click="BtnWakeUp_Click" Cursor="Hand"/>
                    </Grid>
                </Border>

                <Border x:Name="BannerDownloadLocal"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="12,8" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtBannerModelNotice" Text="{DynamicResource Ai_BannerModelMissing_Placeholder}"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ArchitecturalAmberBrush}"/>
                            <ProgressBar x:Name="LocalDownloadProgress" Height="4" Margin="0,4,8,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="BtnDownloadGguf" Grid.Column="1" Content="{DynamicResource Ai_Download_Btn}"
                                FontSize="10" Height="24" Padding="10,0" Click="BtnDownloadGguf_Click" Cursor="Hand"/>
                    </Grid>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="MessagesScroll" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6,8">
                <StackPanel x:Name="MessagesPanel">

                    <Border x:Name="BetaNoticeBanner" Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                            CornerRadius="10" Padding="12,10" Margin="6,4,6,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11" Foreground="#FBBF24" LineHeight="16">
                                <Run FontWeight="Bold" Text="{DynamicResource Ai_Beta_Title}"/>
                                <Run Text=" "/><Run Text="{DynamicResource Ai_Beta_Desc}"/>
                            </TextBlock>
                            <Button Grid.Column="2" Click="BtnDismissBetaNotice_Click" Background="Transparent" BorderThickness="0"
                                    Padding="4" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand" ToolTip="{DynamicResource Ai_Beta_DismissTip}">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AiBubble}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="17">
                                Bonjour ! Je suis <Run FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}">Coclico Copilot</Run>.&#x0a;
                                Je peux analyser ton PC, libérer la RAM, nettoyer les fichiers temporaires, lancer des outils Windows ou répondre à tes questions.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TypingBubble" Style="{StaticResource AiBubble}"
                            Visibility="Collapsed" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtReflecting"
                                       Text="{DynamicResource Ai_Reflecting}"
                                       FontSize="11.5" FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Padding="12,8,12,12"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource BgCardBrush}">
                <StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  BorderThickness="0"
                                  Padding="0,2"
                                  PreviewMouseWheel="ChipsScrollViewer_PreviewMouseWheel"
                                  Height="32" Margin="0,0,0,8">
                        <ScrollViewer.Template>
                            <ControlTemplate TargetType="ScrollViewer">
                                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            </ControlTemplate>
                        </ScrollViewer.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_CleanRam}" Click="ChipCleanRam_Click"/>
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_CleanTemp}" Click="ChipCleanTemp_Click"/>
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_ScanSfc}" Click="ChipScanSfc_Click"/>
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_ScanDism}" Click="ChipScanDism_Click"/>
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_Antivirus}" Click="ChipScanDefender_Click"/>
                            <Button Style="{StaticResource ActionChip}" Content="{DynamicResource Ai_Chip_Diagnose}" Click="ChipDiagnose_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="AttachedImageBadge" Visibility="Collapsed"
                            Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6,4" Margin="0,0,0,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="ImgAttachedThumb" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtAttachedName" Text="Capture_Ecran.png" FontSize="10.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Click="BtnRemoveAttachment_Click" Background="Transparent" BorderThickness="0"
                                    Margin="6,0,0,0" Padding="2" Cursor="Hand" ToolTip="{DynamicResource Ai_Attachment_RemoveTip}">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}"
                                Padding="12,8" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock x:Name="TxtInputPlaceholder"
                                           Text="{DynamicResource Ai_Input_Placeholder}"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtInput"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5"
                                         VerticalAlignment="Center" MaxHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="False"
                                         TextChanged="TxtInput_TextChanged"
                                         KeyDown="TxtInput_KeyDown"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Click="BtnCaptureScreen_Click"
                                Width="36" Height="36" Padding="0" Margin="0,0,6,0"
                                Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="{DynamicResource Ai_CaptureScreen_Tip}">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <Button Grid.Column="2" Click="BtnPasteImage_Click"
                                Width="36" Height="36" Padding="0" Margin="0,0,6,0"
                                Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="{DynamicResource Ai_PasteImage_Tip}">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <Button x:Name="BtnSend" Grid.Column="3" Click="BtnSend_Click"
                                Width="36" Height="36" Padding="0"
                                Background="{DynamicResource PrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" ToolTip="{DynamicResource Ai_Send_Tip}">
                            <ui:SymbolIcon Symbol="Send24" FontSize="16" Foreground="White"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource Ai_Disclaimer}"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,7,0,1"
                               TextAlignment="Center" IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>