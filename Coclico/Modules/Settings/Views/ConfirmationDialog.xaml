<Window x:Class="Coclico.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation" Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCardBrush}"
        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
        Icon="..\..\..\Resources\icone\plage.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage" Text="" FontSize="14" 
                   Foreground="{DynamicResource TextPrimaryBrush}" 
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <CheckBox x:Name="ChkDontAskAgain" Grid.Row="1" Content="" FontSize="12" 
                  Foreground="{DynamicResource TextSecondaryBrush}" 
                  VerticalAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Annuler" 
                    Style="{StaticResource SecondaryButton}" 
                    Width="100" Height="35" 
                    Margin="0,0,12,0" 
                    Click="BtnCancel_Click"/>

            <Button x:Name="BtnConfirm" Content="Confirmer" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="100" Height="35" 
                    Click="BtnConfirm_Click" 
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>