<Window x:Class="Coclico.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Profile_Title}" Height="500" Width="360"
        Icon="..\..\..\Resources\icone\plage.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" MouseDown="Window_MouseDown">
    <Border Margin="12" Background="{DynamicResource BgBaseBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Border Height="2" VerticalAlignment="Top" Margin="18,0" CornerRadius="1"
                    Background="{DynamicResource ArchitecturalYellowBrush}"/>

            <ui:Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" 
                       Margin="14" Appearance="Transparent" Padding="8" Cursor="Hand">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextHintBrush}"/>
            </ui:Button>

            <StackPanel Margin="28,24,28,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:SymbolIcon Symbol="PersonCircle24" FontSize="20" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Profile_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid MouseLeftButtonUp="Avatar_Click" Cursor="Hand" ToolTip="{DynamicResource Profile_AvatarTip}">
                        <Border Width="76" Height="76" CornerRadius="38"
                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="2"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <TextBlock x:Name="UserInitialText" Text="U" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                           FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Image x:Name="UserAvatarImage" Width="72" Height="72" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry RadiusX="36" RadiusY="36" Center="36,36"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BgCardBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1.5">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="11" Foreground="{DynamicResource ArchitecturalYellowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock x:Name="UserNameText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" HorizontalAlignment="Left" Padding="8,3" Margin="0,5,0,5">
                            <TextBlock x:Name="AccountTypeText" Text="{DynamicResource Profile_AccountTypeLocal}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="UserEmailText" Foreground="{DynamicResource TextHintBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,18"/>

                <TextBlock Text="{DynamicResource Profile_SectionManage}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextHintBrush}" Margin="0,0,0,10"/>

                <ui:Button Click="OpenInfo_Click" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10"
                           Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{DynamicResource Profile_WinAccountSettings}" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <ui:SymbolIcon Symbol="ChevronRight24" Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextHintBrush}"/>
                    </Grid>
                </ui:Button>

                <ui:Button Click="OpenAccounts_Click" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10"
                           Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource ArchitecturalAmberBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{DynamicResource Profile_SyncEmails}" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <ui:SymbolIcon Symbol="ChevronRight24" Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextHintBrush}"/>
                    </Grid>
                </ui:Button>

                <ui:Button Click="OpenDataFolder_Click" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10"
                           Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,14,0"/>
                        <TextBlock Text="{DynamicResource Profile_DataFolder}" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <ui:SymbolIcon Symbol="Open24" Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextHintBrush}"/>
                    </Grid>
                </ui:Button>

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="14,10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="#10B981" FontSize="18" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Profile_HealthTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Profile_HealthSubtitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>