<UserControl x:Class="Coclico.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}" d:DesignHeight="800" d:DesignWidth="1100">

    <Grid x:Name="PageRoot" Margin="32,24,32,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="{DynamicResource Menu_HelpAndAi}" FontSize="9" FontWeight="Black"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,12"
                       FontFamily="Consolas, Courier New"/>
            <ListBox Background="Transparent" BorderThickness="0" SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="SelectionStates">
                                                <VisualState x:Name="Selected">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource BgCardBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Unselected"/>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem Tag="Guide" Selected="Section_Click" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BookOpen24" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Help_GuideTab}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Version" Selected="Section_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Tag24" FontSize="15" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Help_VersionTab}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem Tag="Info" Selected="Section_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Help_InfoTab}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,24">

                <Border x:Name="PanelGuide" CornerRadius="{DynamicResource CornerCard}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="26,22" Margin="0,0,0,24"
                        Background="{DynamicResource BgCardBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Help_Guide}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Help_Guide_Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                        <Border Height="1" Margin="0,0,0,20" Background="{DynamicResource BorderSubtleBrush}"/>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4A1FA8" Offset="0"/>
                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Home24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Dashboard_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Dashboard_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0284C7" Offset="0"/>
                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Network_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Network_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#991B1B" Offset="0"/>
                                            <GradientStop Color="#DC2626" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Cleaning_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Cleaning_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#5B21B6" Offset="0"/>
                                            <GradientStop Color="#8B5CF6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Memory16" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Ram_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Ram_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0369A1" Offset="0"/>
                                            <GradientStop Color="#0D9488" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Health_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Health_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#16A34A" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Programs_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Programs_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0E4A6A" Offset="0"/>
                                            <GradientStop Color="#0284C7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Installer_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Installer_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C3AED" Offset="0"/>
                                            <GradientStop Color="#BE185D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Bot24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Ai_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Ai_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="16,14" Margin="0,0,0,0"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{StaticResource CornerNode}" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#334155" Offset="0"/>
                                            <GradientStop Color="#475569" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{DynamicResource Help_Guide_Settings_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Guide_Settings_Content}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <Border x:Name="PanelVersion" Visibility="Collapsed"
                        CornerRadius="{DynamicResource CornerCard}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="26,22"
                        Background="{DynamicResource BgCardBrush}">
                    <StackPanel>
                        <TextBlock x:Name="TxtVersionTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Help_Version_Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                        <Border Height="1" Margin="0,0,0,20" Background="{DynamicResource BorderSubtleBrush}"/>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="24,20" Margin="0,0,0,20"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtVersionTag" FontSize="12" FontWeight="ExtraBold" Foreground="White"/>
                                    </Border>
                                    <Border Background="#30FFFFFF" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{DynamicResource Help_Version_StatusBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtVersionCardTitle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtVersionDesc" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtVersionNotesTitle" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,12"/>

                        <Border CornerRadius="{StaticResource CornerSmall}" Padding="14,12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Help_Version_Note1}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerSmall}" Padding="14,12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Help_Version_Note2}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerSmall}" Padding="14,12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Help_Version_Note3}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerSmall}" Padding="14,12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Help_Version_Note4}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerSmall}" Padding="14,12" Margin="0,0,0,0"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Background="{DynamicResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Help_Version_Note5}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelInfo" Visibility="Collapsed"
                        CornerRadius="{DynamicResource CornerCard}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Padding="26,22"
                        Background="{DynamicResource BgCardBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Help_Info_Title}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Help_Info_Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>
                        <Border Height="1" Margin="0,0,0,20" Background="{DynamicResource BorderSubtleBrush}"/>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="20,18" Margin="0,0,0,14"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top"
                                        Background="{DynamicResource PrimaryBrush}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help_Info_Dev_Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{DynamicResource Help_Info_Dev_Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource Help_Info_Dev_Role}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="20,18" Margin="0,0,0,14"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F59E0B" Offset="0"/>
                                            <GradientStop Color="#D97706" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help_Info_Status_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtInfoStatusText" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{StaticResource CornerNode}" Padding="20,18" Margin="0,0,0,0"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Top">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help_Info_Vision_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Help_Info_Vision_Text}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>