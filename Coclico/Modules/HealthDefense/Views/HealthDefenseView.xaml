<UserControl x:Class="Coclico.Views.HealthDefenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}"
             d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>

        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ToolIcon" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{DynamicResource TextHintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Health_HeaderBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Health_Title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Health_Subtitle}"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="2" CornerRadius="8" Padding="12,7"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                            Background="{DynamicResource SuccessBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Health_DefenderActive}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding LastUpdatedText, StringFormat='Signatures : {0}'}"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                        Background="#1A1C24" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Health_OneClickFixTitle}" FontSize="14" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="{DynamicResource Health_OneClickFixDesc}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>

                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CurrentStepDescription}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextAccentBrush}" Margin="0,0,0,3"/>
                        <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                     Foreground="{DynamicResource ArchitecturalYellowBrush}" Background="#20FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="Annuler la réparation en cours"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Padding="12,8" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Health_CancelFix}" FontWeight="Bold" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ArchitecturalActionCard}" Command="{Binding RunFullRepairCommand}"
                            AutomationProperties.Name="Lancer la réparation intégrale Windows 1-clic"
                            IsEnabled="{Binding IsNotBusy}" Padding="18,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Health_LaunchOneClickFix}" FontSize="12" FontWeight="Bold" Foreground="#0A0A0C" VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" Foreground="#0A0A0C" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Health_SecDefHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Bug24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_MrtTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_MrtDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Ouvrir MRT"
                                    Command="{Binding LaunchMrtCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_OpenBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="#10B981"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_DefenderQuickTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_DefenderQuickDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Lancer scan rapide Defender"
                                    Command="{Binding RunQuickScanCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_ScanBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="ShieldTask24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_DefenderFullTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_DefenderFullDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Lancer scan complet Defender"
                                    Command="{Binding RunFullScanCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_ScanBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="{DynamicResource ArchitecturalAmberBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_SignaturesTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_SignaturesDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding UpdateSignaturesCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_UpdateBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Power24" FontSize="15" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_WdoTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_WdoDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Programmer analyse hors-ligne"
                                    Command="{Binding RunOfflineScanCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_ScheduleBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Health_DiagRepHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Document24" FontSize="15" Foreground="#10B981"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_SfcTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_SfcDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Lancer SFC /scannow"
                                    Command="{Binding RunSfcCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_LaunchBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Foreground="{DynamicResource ArchitecturalAmberBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_DismTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_DismDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Lancer DISM RestoreHealth"
                                    Command="{Binding RunDismRestoreCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_LaunchBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="HardDrive24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_ChkdskTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_ChkdskDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RunChkdskCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_ScanBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="15" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_NetResetTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_NetResetDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetNetworkCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_RepairBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ToolCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ToolIcon}">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_WuFixTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Health_WuFixDesc}"
                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetUpdateCommand}" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Health_UnblockBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="6" CornerRadius="3" Background="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Health_SysStateHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                            Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Health_DefenderTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="8,4" Background="#0D1F10" BorderBrush="#166534" BorderThickness="1">
                                <TextBlock Text="{DynamicResource Health_DefenderState}" FontSize="11" FontWeight="Bold" Foreground="#22C55E"/>
                            </Border>
                            <TextBlock Text="{Binding LastUpdatedText, StringFormat='Signatures : {0}'}"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                            Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="16" Foreground="#818CF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Health_FirewallTitle}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border CornerRadius="4" Padding="8,4" Background="#0C0F2A" BorderBrush="#3730A3" BorderThickness="1">
                                <TextBlock Text="{DynamicResource Health_FirewallState}" FontSize="11" FontWeight="Bold" Foreground="#818CF8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="12,10"
                            Background="#0A1A0A" BorderBrush="#14532D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Health_TipsHeader}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#86EFAC" Margin="0,0,0,8"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" LineHeight="16">
                                <Run Text="{DynamicResource Health_Tip1}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource Health_Tip2}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource Health_Tip3}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource Health_Tip4}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" CornerRadius="10" Padding="12,8"
                Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#22C55E" Margin="0,0,8,0">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="{DynamicResource Health_LiveLogHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}" FontFamily="Consolas, Courier New"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding ClearLogCommand}"
                            Background="Transparent" BorderThickness="0" Padding="6,2"
                            Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Health_ClearBtn}" FontSize="10"/>
                    </Button>
                </Grid>

                <ListBox x:Name="ConsoleListBox" Grid.Row="1"
                         ItemsSource="{Binding OutputLog}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="#A5B4FC"
                                       FontFamily="Consolas, Courier New" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</UserControl>