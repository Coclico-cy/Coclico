<UserControl x:Class="Coclico.Views.RamCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{DynamicResource BgBaseBrush}"
             RenderOptions.BitmapScalingMode="HighQuality">

    <UserControl.Resources>

        <Style x:Key="RC.Card" TargetType="Border">
            <Setter Property="Background"       Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="CornerRadius"     Value="{DynamicResource CornerCard}"/>
            <Setter Property="Padding"          Value="20,16"/>
            <Setter Property="Margin"           Value="0,0,0,12"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RC.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <Style x:Key="RC.Value" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="RC.Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="ModeHelpToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="#101117"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" MaxWidth="340">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF6B35" BlurRadius="16" Opacity="0.35" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RC.Sep" TargetType="Border">
            <Setter Property="Width"      Value="1"/>
            <Setter Property="Margin"     Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>

        <Style x:Key="ProfileBtn" TargetType="Button">
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="14,14"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Background"       Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BorderAccentSecondaryBrush}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.02" Duration="0:0:0.14" EasingFunction="{StaticResource SpringEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.02" Duration="0:0:0.14" EasingFunction="{StaticResource SpringEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.14" EasingFunction="{StaticResource SmoothEaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.14" EasingFunction="{StaticResource SmoothEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.96" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.96" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.20" EasingFunction="{StaticResource SpringBounce}"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.20" EasingFunction="{StaticResource SpringBounce}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot" Margin="32,28,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{DynamicResource TextHintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MONITEUR &amp; PURGE DE LA MÉMOIRE VIVE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource RamCleaner_Title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="PressureBorder"
                            BorderBrush="{Binding PressureBorderColor, Mode=OneWay}"
                            BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="14,0,0,0"
                            Background="{DynamicResource BgElevatedBrush}">
                        <TextBlock Text="{Binding PressureText, Mode=OneWay}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding PressureColor, Mode=OneWay}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <Run Text="{DynamicResource RamCleaner_AppLabel}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding AppRamText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                        <Run Text="  ·  " Foreground="{DynamicResource TextHintBrush}"/>
                        <Run Text="{Binding AppCpuText, Mode=OneWay}" Foreground="{DynamicResource ArchitecturalYellowBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnToggleNotif" Style="{StaticResource SecondaryButton}"
                        Padding="12,8" Margin="0,0,10,0" FontSize="11"
                        Content="{Binding NotifButtonLabel}"
                        Click="BtnToggleNotif_Click"/>
                <Button x:Name="BtnClean" Style="{StaticResource ArchitecturalActionCard}"
                        Padding="18,10"
                        IsEnabled="{Binding IsNotCleaning}"
                        Click="BtnClean_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource RamCleaner_CleanBtn}" FontSize="12" FontWeight="Bold" Foreground="#0A0A0C" VerticalAlignment="Center"/>
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" Foreground="#0A0A0C" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,32">
            <StackPanel>

                <Border Style="{StaticResource RC.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                                        Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Memory16" FontSize="11" Foreground="#818CF8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource RamCleaner_PhysMemory}" Style="{StaticResource RC.SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding PhysUsedText}" Style="{StaticResource RC.Value}"/>
                                <TextBlock Text="{Binding PhysPercent}" HorizontalAlignment="Right"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Bottom"/>
                            </Grid>
                            <ProgressBar Value="{Binding PhysUsedPercent, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Height="4" Margin="0,0,0,7"
                                         Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryBrush}"/>
                            <Grid>
                                <TextBlock Style="{StaticResource RC.Label}">
                                    <Run Text="{DynamicResource RamCleaner_Free}"/><Run Text=" "/><Run Text="{Binding PhysAvailText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource RC.Label}" HorizontalAlignment="Right">
                                    <Run Text="{DynamicResource RamCleaner_Total}"/><Run Text=" "/><Run Text="{Binding PhysTotalText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource RC.Sep}"/>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                                        Background="#082F49" BorderBrush="#0369A1" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="11" Foreground="#38BDF8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource RamCleaner_CommitVirtual}" Style="{StaticResource RC.SectionTitle}" Margin="0" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource RamCleaner_CommitTooltip}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding VirtUsedText}" Style="{StaticResource RC.Value}"/>
                                <TextBlock Text="{Binding VirtPercent}" HorizontalAlignment="Right"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" VerticalAlignment="Bottom"/>
                            </Grid>
                            <ProgressBar Value="{Binding VirtUsedPercent, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Height="4" Margin="0,0,0,7"
                                         Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                                         Foreground="{DynamicResource CyanBrush}"/>
                            <Grid>
                                <TextBlock Style="{StaticResource RC.Label}">
                                    <Run Text="{DynamicResource RamCleaner_Free}"/><Run Text=" "/><Run Text="{Binding VirtAvailText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource RC.Label}" HorizontalAlignment="Right">
                                    <Run Text="{DynamicResource RamCleaner_Total}"/><Run Text=" "/><Run Text="{Binding VirtTotalText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource RC.Sep}"/>

                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                                        Background="#2D1807" BorderBrush="#7C2D12" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="11" Foreground="#FB923C"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource RamCleaner_MetricPagefile}" Style="{StaticResource RC.SectionTitle}" Margin="0" VerticalAlignment="Center"
                                           ToolTip="{DynamicResource RamCleaner_PagefileTooltip}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PageUsedText}" Style="{StaticResource RC.Value}" FontSize="18"/>
                            <TextBlock Style="{StaticResource RC.Label}" Margin="0,4,0,0">
                                <Run Text="{DynamicResource RamCleaner_Free}"/><Run Text=" "/><Run Text="{Binding PageAvailText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource RC.Label}">
                                <Run Text="{DynamicResource RamCleaner_Capacity}"/><Run Text=" "/><Run Text="{Binding PageTotalText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RC.Card}" BorderBrush="{DynamicResource BorderDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource RamCleaner_History}" Style="{StaticResource RC.SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PhysPercent, Mode=OneWay}" HorizontalAlignment="Right"
                                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border CornerRadius="8" Height="70"
                                    BorderThickness="1"
                                    Background="{DynamicResource BgElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Canvas x:Name="HistoryCanvas" Height="70"
                                        SizeChanged="HistoryCanvas_SizeChanged"/>
                            </Border>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="0%" Style="{StaticResource RC.Label}" HorizontalAlignment="Left"/>
                                <TextBlock Text="45s" Style="{StaticResource RC.Label}" HorizontalAlignment="Center"/>
                                <TextBlock Text="100%" Style="{StaticResource RC.Label}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border CornerRadius="{DynamicResource CornerCard}" Padding="16,14" Margin="0,0,0,0"
                                    Background="#0C1F16" BorderBrush="#166534" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource RamCleaner_Session}" Style="{StaticResource RC.SectionTitle}"/>
                                    <TextBlock Text="{Binding CumulativeFreedText, Mode=OneWay}"
                                               FontSize="22" FontWeight="Bold" Foreground="#22C55E"/>
                                    <TextBlock Text="{DynamicResource RamCleaner_SessionFreed}" Style="{StaticResource RC.Label}" Margin="0,2,0,8"/>
                                    <TextBlock Text="{Binding LastCleanedText, Mode=OneWay}"
                                               Style="{StaticResource RC.Label}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding GuardStatusText, Mode=OneWay}"
                                               Style="{StaticResource RC.Label}"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RC.Card}"
                        Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource RamCleaner_Cleaning}" Style="{StaticResource RC.SectionTitle}"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Background="{DynamicResource BgElevatedBrush}"
                                         Foreground="{DynamicResource PrimaryBrush}"
                                         BorderThickness="0" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CleaningStatus}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Consolas, Courier New"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource RC.Card}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource RamCleaner_LastResult}" Style="{StaticResource RC.SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource RamCleaner_AppMemLabel}" Style="{StaticResource RC.Label}"/>
                                <TextBlock Text="{Binding ResultWorkingSets}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource RamCleaner_MetricStandbyCache}" Style="{StaticResource RC.Label}"/>
                                <TextBlock Text="{Binding ResultStandby}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource RamCleaner_LowPri}" Style="{StaticResource RC.Label}"/>
                                <TextBlock Text="{Binding ResultLowPriorityStandby}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{DynamicResource RamCleaner_FileCache}" Style="{StaticResource RC.Label}"/>
                                <TextBlock Text="{Binding ResultModifiedFileCache}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource RamCleaner_MetricSysCache}" Style="{StaticResource RC.Label}"/>
                                <TextBlock Text="{Binding ResultSystemFileCache}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Margin="0,10" Background="{DynamicResource BorderSubtleBrush}"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource RamCleaner_MetricTotalFreed}" FontSize="11" FontWeight="Black"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                           FontFamily="Consolas, Courier New"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ResultTotal}" FontSize="22" FontWeight="Bold"
                                       Foreground="#22C55E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource RamCleaner_WorkingSetNote}" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Border Style="{StaticResource RC.Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource RamCleaner_ProfilesTitle}" Style="{StaticResource RC.SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnQuickClean" Grid.Column="0"
                                            Style="{StaticResource ProfileBtn}"
                                            IsEnabled="{Binding IsNotCleaning}"
                                            Click="BtnQuickClean_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,2">
                                                <ui:SymbolIcon Symbol="Flash24" FontSize="20" HorizontalAlignment="Center" Foreground="#818CF8"/>
                                                <TextBlock Text="{DynamicResource RamCleaner_ProfileQuick}" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="~1–2 s" HorizontalAlignment="Center"
                                                           FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                    Width="18" Height="18" CornerRadius="9"
                                                    Background="#1E264A" BorderBrush="#3B497A" BorderThickness="1"
                                                    ToolTipService.InitialShowDelay="40"
                                                    ToolTipService.ShowDuration="30000"
                                                    Cursor="Help">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ModeHelpToolTip}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:SymbolIcon Symbol="Flash24" FontSize="13" Foreground="#818CF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource RamCleaner_ModeQuick_Title}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{DynamicResource RamCleaner_ModeQuick_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                            <TextBlock FontSize="10.5" Foreground="#CBD5E1" LineHeight="16">
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#818CF8" Text="{DynamicResource RamCleaner_ModeQuick_Item1_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeQuick_Item1_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#818CF8" Text="{DynamicResource RamCleaner_ModeQuick_Item2_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeQuick_Item2_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Foreground="#10B981" FontWeight="SemiBold" Text="{DynamicResource RamCleaner_ModeQuick_Badge}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="11" Foreground="#818CF8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnSmartClean" Grid.Column="2"
                                            Style="{StaticResource ProfileBtn}"
                                            IsEnabled="{Binding IsNotCleaning}"
                                            Click="BtnSmartClean_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,2">
                                                <ui:SymbolIcon Symbol="Brain24" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}"/>
                                                <TextBlock Text="{DynamicResource RamCleaner_ModeSmart_Name}" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                                <TextBlock Text="{DynamicResource RamCleaner_ModeSmart_Tag}" HorizontalAlignment="Center"
                                                           FontSize="9.5" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                    Width="18" Height="18" CornerRadius="9"
                                                    Background="#082F49" BorderBrush="#0284C7" BorderThickness="1"
                                                    ToolTipService.InitialShowDelay="40"
                                                    ToolTipService.ShowDuration="30000"
                                                    Cursor="Help">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ModeHelpToolTip}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:SymbolIcon Symbol="Brain24" FontSize="13" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource RamCleaner_ModeSmart_Title}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{DynamicResource RamCleaner_ModeSmart_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                            <TextBlock FontSize="10.5" Foreground="#CBD5E1" LineHeight="16">
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#00F0FF" Text="{DynamicResource RamCleaner_ModeSmart_Item1_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeSmart_Item1_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#00F0FF" Text="{DynamicResource RamCleaner_ModeSmart_Item2_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeSmart_Item2_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Foreground="#00F0FF" FontWeight="SemiBold" Text="{DynamicResource RamCleaner_ModeSmart_Badge}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnNormalClean" Grid.Column="4"
                                            Style="{StaticResource ProfileBtn}"
                                            IsEnabled="{Binding IsNotCleaning}"
                                            Click="BtnNormalClean_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,2">
                                                <ui:SymbolIcon Symbol="Broom24" FontSize="20" HorizontalAlignment="Center" Foreground="#10B981"/>
                                                <TextBlock Text="{DynamicResource RamCleaner_ProfileNormal}" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="~3–5 s" HorizontalAlignment="Center"
                                                           FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                    Width="18" Height="18" CornerRadius="9"
                                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                                    ToolTipService.InitialShowDelay="40"
                                                    ToolTipService.ShowDuration="30000"
                                                    Cursor="Help">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ModeHelpToolTip}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:SymbolIcon Symbol="Broom24" FontSize="13" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource RamCleaner_ModeNormal_Title}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{DynamicResource RamCleaner_ModeNormal_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                            <TextBlock FontSize="10.5" Foreground="#CBD5E1" LineHeight="16">
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#10B981" Text="{DynamicResource RamCleaner_ModeNormal_Item1_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeNormal_Item1_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#10B981" Text="{DynamicResource RamCleaner_ModeNormal_Item2_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeNormal_Item2_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Foreground="#10B981" FontWeight="SemiBold" Text="{DynamicResource RamCleaner_ModeNormal_Badge}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="11" Foreground="#34D399"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnDeepClean" Grid.Column="6"
                                            Style="{StaticResource ProfileBtn}"
                                            IsEnabled="{Binding IsNotCleaning}"
                                            Click="BtnDeepClean_Click">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,2">
                                                <ui:SymbolIcon Symbol="Fire24" FontSize="20" HorizontalAlignment="Center" Foreground="#F97316"/>
                                                <TextBlock Text="{DynamicResource RamCleaner_ProfileDeep}" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="~5–10 s" HorizontalAlignment="Center"
                                                           FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                    Width="18" Height="18" CornerRadius="9"
                                                    Background="#431407" BorderBrush="#EA580C" BorderThickness="1"
                                                    ToolTipService.InitialShowDelay="40"
                                                    ToolTipService.ShowDuration="30000"
                                                    Cursor="Help">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ModeHelpToolTip}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <ui:SymbolIcon Symbol="Fire24" FontSize="13" Foreground="#F97316" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource RamCleaner_ModeDeep_Title}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{DynamicResource RamCleaner_ModeDeep_Subtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                                            <TextBlock FontSize="10.5" Foreground="#CBD5E1" LineHeight="16">
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#FB923C" Text="{DynamicResource RamCleaner_ModeDeep_Item1_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeDeep_Item1_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Text="• "/><Run FontWeight="SemiBold" Foreground="#FB923C" Text="{DynamicResource RamCleaner_ModeDeep_Item2_Title}"/><Run Text=" : "/><Run Text="{DynamicResource RamCleaner_ModeDeep_Item2_Desc}"/><Run Text="&#x0a;"/>
                                                                <Run Foreground="#F97316" FontWeight="SemiBold" Text="{DynamicResource RamCleaner_ModeDeep_Badge}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <ui:SymbolIcon Symbol="QuestionCircle16" FontSize="11" Foreground="#FB923C"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RC.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource RamCleaner_AutoSection}" Style="{StaticResource RC.SectionTitle}"/>
                                    <CheckBox x:Name="ChkAutoClean" IsChecked="{Binding AutoCleanEnabled}"
                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,10"
                                              Checked="ChkAutoClean_Changed" Unchecked="ChkAutoClean_Changed">
                                        <TextBlock Text="{DynamicResource RamCleaner_AutoDaemon_Enable}" FontWeight="SemiBold"/>
                                    </CheckBox>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mode de nettoyage auto :" Style="{StaticResource RC.Label}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="CboAutoProfile" Grid.Column="1" SelectedIndex="0"
                                                  IsEnabled="{Binding AutoCleanEnabled}"
                                                  SelectionChanged="CboAutoProfile_Changed">
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ModeSmart}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ModeQuick}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ModeNormal}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ModeDeep}"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CboAutoMode" Grid.Column="0" SelectedIndex="0"
                                                  IsEnabled="{Binding AutoCleanEnabled}"
                                                  SelectionChanged="CboAutoMode_Changed">
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ByInterval}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ByThreshold}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_ModeHybrid}"/>
                                        </ComboBox>

                                        <ComboBox x:Name="CboAutoInterval" Grid.Column="2" SelectedIndex="2"
                                                  IsEnabled="{Binding AutoCleanEnabled}"
                                                  SelectionChanged="CboAutoInterval_Changed">
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_1Min}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_5Min}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_15Min}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_30Min}"/>
                                            <ComboBoxItem Content="{DynamicResource RamCleaner_AutoDaemon_1Hour}"/>
                                        </ComboBox>

                                        <ComboBox x:Name="CboAutoThreshold" Grid.Column="2" SelectedIndex="2" Visibility="Collapsed"
                                                  IsEnabled="{Binding AutoCleanEnabled}"
                                                  SelectionChanged="CboAutoThreshold_Changed">
                                            <ComboBoxItem Content="70 %"/>
                                            <ComboBoxItem Content="75 %"/>
                                            <ComboBoxItem Content="80 %"/>
                                            <ComboBoxItem Content="85 %"/>
                                            <ComboBoxItem Content="90 %"/>
                                            <ComboBoxItem Content="95 %"/>
                                        </ComboBox>

                                        <Border x:Name="BrdAutoHybrid" Grid.Column="2" Visibility="Collapsed"
                                                Background="{DynamicResource BgElevatedBrush}"
                                                CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                Padding="6,6" VerticalAlignment="Center">
                                            <TextBlock Text="Auto (ISLC)" FontSize="11" Foreground="#94A3B8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <CheckBox x:Name="ChkProtectForeground" IsChecked="{Binding ProtectForeground}"
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"
                                              Checked="ChkProtectForeground_Changed" Unchecked="ChkProtectForeground_Changed">
                                        <TextBlock Text="{DynamicResource RamCleaner_AutoDaemon_ProtectForeground}" FontSize="11"/>
                                    </CheckBox>

                                    <Border Background="#161318" BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FF6B35" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#FF5722" BlurRadius="8" Opacity="0.9" ShadowDepth="0"/>
                                                </Border.Effect>
                                            </Border>
                                            <TextBlock Text="{Binding AutoCleanStatusText}"
                                                       Foreground="{DynamicResource TextAccentBrush}"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource RC.Sep}"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource RamCleaner_GuardSection}" Style="{StaticResource RC.SectionTitle}"/>
                                    <ComboBox x:Name="CboRefreshRate" SelectedIndex="1"
                                              SelectionChanged="CboRefreshRate_Changed">
                                        <ComboBoxItem Content="{DynamicResource RamCleaner_Interval_500ms}"/>
                                        <ComboBoxItem Content="{DynamicResource RamCleaner_Interval_1s}"/>
                                        <ComboBoxItem Content="{DynamicResource RamCleaner_Interval_2s}"/>
                                        <ComboBoxItem Content="{DynamicResource RamCleaner_Interval_5s}"/>
                                        <ComboBoxItem Content="{DynamicResource RamCleaner_Interval_10s}"/>
                                    </ComboBox>

                                    <Button x:Name="BtnClearShaders" Margin="0,12,0,0" Padding="8,6"
                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                            Click="BtnClearShaders_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource RamCleaner_Gpu_ClearShaders}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnRestartGpuPipeline" Margin="0,6,0,0" Padding="8,6"
                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                            Click="BtnRestartGpuPipeline_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource RamCleaner_Gpu_ResetDwm}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource RC.Card}"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RamCleaner_SectionSysApp}" Style="{StaticResource RC.SectionTitle}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center"
                                        Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="11" Foreground="#818CF8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{DynamicResource RamCleaner_MetricCpuSys}" Style="{StaticResource RC.Label}" Margin="0,0,0,3"/>
                                    <ProgressBar Value="{Binding SysCpuPercent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100" Height="4"
                                                 Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                                                 Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SysCpuText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Consolas, Courier New"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center"
                                        Background="#062814" BorderBrush="#16532A" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Memory16" FontSize="11" Foreground="#10B981"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{DynamicResource RamCleaner_MetricRamApp}" Style="{StaticResource RC.Label}" Margin="0,0,0,3"/>
                                    <ProgressBar Value="{Binding AppRamPercent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100" Height="4"
                                                 Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                                                 Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding AppRamText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Consolas, Courier New"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center"
                                        Background="#2D1807" BorderBrush="#7C2D12" BorderThickness="1">
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="11" Foreground="#FB923C"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{DynamicResource RamCleaner_MetricCpuApp}" Style="{StaticResource RC.Label}" Margin="0,0,0,3"/>
                                    <ProgressBar Value="{Binding AppCpuPercent, Mode=OneWay}"
                                                 Minimum="0" Maximum="100" Height="4"
                                                 Background="{DynamicResource BgElevatedBrush}" BorderThickness="0"
                                                 Foreground="{DynamicResource WarnBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding AppCpuText, Mode=OneWay}"
                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Consolas, Courier New"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Visibility="Collapsed">
            <CheckBox x:Name="ChkWorkingSets" IsChecked="True"/>
            <CheckBox x:Name="ChkModifiedFileCache" IsChecked="True"/>
            <CheckBox x:Name="ChkSystemFileCache" IsChecked="True"/>
            <CheckBox x:Name="ChkRegistryCache" IsChecked="True"/>
            <CheckBox x:Name="ChkStandby" IsChecked="True"/>
            <CheckBox x:Name="ChkLowPriorityStandby" IsChecked="True"/>
            <CheckBox x:Name="ChkCombinedPages" IsChecked="True"/>
            <CheckBox x:Name="ChkModifiedPages" IsChecked="True"/>
            <CheckBox x:Name="ChkDnsCache" IsChecked="True"/>
            <CheckBox x:Name="ChkGcCollect" IsChecked="True"/>
            <CheckBox x:Name="ChkStandbyFast" IsChecked="True"/>
            <CheckBox x:Name="ChkKernelTrim" IsChecked="True"/>
            <CheckBox x:Name="ChkArpCache" IsChecked="True"/>
            <CheckBox x:Name="ChkNetBios" IsChecked="True"/>
            <CheckBox x:Name="ChkAllSessions" IsChecked="True"/>
            <CheckBox x:Name="ChkClipboard" IsChecked="True"/>
            <CheckBox x:Name="ChkCompactHeaps" IsChecked="True"/>
            <CheckBox x:Name="ChkSuperFetch" IsChecked="True"/>
        </StackPanel>
    </Grid>
</UserControl>