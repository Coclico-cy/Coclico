<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Coclico.Modules.Apps.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}" d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>

        <Style x:Key="AppsTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter Property="Foreground" Value="#0A0A0C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.4" ShadowDepth="2"/>
                    </Border.Effect>
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#38BDF8"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Installer_Title}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Installer_Subtitle}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Border CornerRadius="8" Padding="10,5" Margin="0,0,10,0"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Foreground="#22C55E"
                                      Visibility="{Binding IsWingetReady, Converter={StaticResource BoolToVis}}"/>
                        <ui:SymbolIcon Symbol="Warning24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Foreground="#F59E0B"
                                      Visibility="{Binding IsWingetMissing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding WingetStatusText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding RepairWingetCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Padding="14,8" Cursor="Hand"
                        Visibility="{Binding IsWingetMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Apps_WingetRepair}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="6" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">

                <RadioButton Style="{StaticResource AppsTabStyle}"
                             GroupName="AppsTabs"
                             IsChecked="{Binding IsTabInstaller, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="Installer"
                             Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="AppsList24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Menu_Installer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource AppsTabStyle}"
                             GroupName="AppsTabs"
                             IsChecked="{Binding IsTabPacks, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="Packs"
                             Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Menu_Packs}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

            </StackPanel>
        </Border>

        <Grid Grid.Row="2">

            <Grid Visibility="{Binding IsTabInstaller, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="12" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" Margin="0,0,6,4"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock Text="{Binding SelectedCountText}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectAllCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Padding="8,5" Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource Installer_SelectAll}" FontSize="11"/>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeselectAllCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Padding="8,5" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Installer_DeselectAll}" FontSize="11"/>
                        </Button>

                        <Button Command="{Binding InstallSelectedCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Installer_InstallSelected}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="100"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             BorderThickness="0" Foreground="{DynamicResource PrimaryBrush}"
                             Margin="0,0,0,10"
                             Visibility="{Binding IsOperating, Converter={StaticResource BoolToVis}}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredApps}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="14,12" Margin="4,4,4,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Padding="6,2" Margin="0,0,6,0"
                                                        Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1"
                                                        Visibility="{Binding IsGithub, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="GitHub" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="6,2"
                                                        Background="{DynamicResource BgElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" MaxHeight="32" Margin="28,4,0,8"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Grid Grid.Row="2" Margin="28,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Identifier}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Padding="10,5"
                                                        Background="#0D2E1A" BorderBrush="#166534" BorderThickness="1"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✓ " FontSize="11" FontWeight="Bold" Foreground="#22C55E"/>
                                                        <TextBlock Text="{DynamicResource Installer_AlreadyInstalled}" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E"/>
                                                    </StackPanel>
                                                </Border>

                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.InstallOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Padding="12,5" Margin="6,0,0,0"
                                                        Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{DynamicResource Installer_Install}" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.UninstallOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Padding="12,5" Margin="6,0,0,0"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{DynamicResource Installer_Status_Uninstalling}" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="3" Margin="28,8,0,0"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Margin="28,8,0,0"
                                                   Foreground="#EF4444"
                                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Installer_SearchAnyApp}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Installer_SearchAnyAppDesc}" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OnlineSearchCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Installer_SearchBtn}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ui:TextBox Text="{Binding OnlineQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{DynamicResource Installer_SearchPlaceholder}"
                                    KeyDown="OnlineQuery_KeyDown"
                                    FontSize="12"/>

                        <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgPanelBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                        Background="{DynamicResource BgElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                        Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>

                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.InstallSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Padding="12,4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{DynamicResource Installer_Install}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Visibility="{Binding IsTabPacks, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Packs}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCardBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="14,12" Margin="4,4,4,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="6" Padding="6,2" Margin="8,0,0,0"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InstalledCountText}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.InstallPackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="12,5" Margin="10,0,0,0" Cursor="Hand"
                                                Visibility="{Binding AllInstalled, Converter={StaticResource BoolToVisInv}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0" Foreground="White"/>
                                                <TextBlock Text="{DynamicResource Packs_BtnInstall}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,8"/>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgPanelBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsPackChecked, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsNotInstalled}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border CornerRadius="6" Padding="8,3"
                                                                    Background="#0D2E1A" BorderBrush="#166534" BorderThickness="1"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="✓ " FontSize="10" FontWeight="Bold" Foreground="#22C55E"/>
                                                                    <TextBlock Text="{DynamicResource Packs_ItemInstalled}" FontSize="10" FontWeight="SemiBold" Foreground="#22C55E"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Button Style="{StaticResource SecondaryButton}"
                                                                    Command="{Binding DataContext.InstallOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Padding="10,3" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="{DynamicResource Installer_Install}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="3" Margin="0,8,0,0"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_TerminalHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="Consolas, Courier New" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding OperationStatus}"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding ClearLogCommand}"
                                Padding="8,3" Margin="0,0,6,0" ToolTip="{DynamicResource Installer_ClearBtn}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Installer_ClearBtn}" FontSize="10.5"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelCommand}"
                                Padding="12,4" Background="#DC2626" Foreground="White" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsOperating, Converter={StaticResource BoolToVis}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="White" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Installer_StopBtn}" FontSize="10.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,6"
                             Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisInv}}"/>

                <Border Grid.Row="2" Background="#06090E" CornerRadius="6"
                        BorderBrush="#1E293B" BorderThickness="1" Padding="8,6" Margin="0,4,0,0">
                    <ListBox x:Name="OutputListBox" ItemsSource="{Binding OutputLog}"
                             Height="95" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                             Foreground="#94A3B8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
