<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Coclico.Views.DiagnosticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}"
             d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>

        <Style x:Key="DiagCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DiagCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,14,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="3" Height="3" CornerRadius="1.5" Background="{DynamicResource TextHintBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Diag_Badge}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Border Width="4" Height="30" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Diag_Title}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Diag_Subtitle}" FontSize="12"
                           Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding LastRunText}" FontSize="11"
                           Foreground="{DynamicResource TextHintBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DiagCard}" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunQuickCommand}"
                            Margin="0,0,10,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Diag_Button_Quick}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RunFullCommand}"
                            Margin="0,0,10,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Diag_Button_Full}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"
                            Margin="0,0,10,0" Padding="14,8" IsEnabled="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Diag_Button_Cancel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVisInv}}">
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True"
                                 Foreground="{DynamicResource AccentPrimaryBrush}"
                                 Background="{DynamicResource BgSurfaceBrush}"
                                 BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Separator Margin="0,12,0,10" Background="{DynamicResource BorderSubtleBrush}"/>

                <TextBlock Text="{DynamicResource Diag_Lbl_SelectCategories}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextHintBrush}" Margin="0,0,0,6"/>

                <WrapPanel>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Windows}" IsChecked="{Binding SelectWindows}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Cpu}" IsChecked="{Binding SelectCpu}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Gpu}" IsChecked="{Binding SelectGpu}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Memory}" IsChecked="{Binding SelectMemory}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Storage}" IsChecked="{Binding SelectStorage}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Network}" IsChecked="{Binding SelectNetwork}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Power}" IsChecked="{Binding SelectPower}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Devices}" IsChecked="{Binding SelectDevices}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Processes}" IsChecked="{Binding SelectProcesses}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Security}" IsChecked="{Binding SelectSecurity}"/>
                    <CheckBox Style="{StaticResource DiagCheck}" Content="{DynamicResource Diag_Category_Motherboard}" IsChecked="{Binding SelectMotherboard}"/>
                </WrapPanel>

                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RunTargetedCommand}"
                        Margin="0,8,0,0" Padding="16,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Diag_Button_Targeted}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DiagCard}" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding CategoryCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="168" Margin="0,0,10,10" Padding="10,8"
                                CornerRadius="{DynamicResource CornerBtn}"
                                Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{Binding StateBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FindingsText}" FontSize="10.5" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextHintBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DiagCard}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Diag_Lbl_Findings}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12,10"
                                            CornerRadius="{DynamicResource CornerCard}"
                                            Background="{DynamicResource BgSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="{DynamicResource CornerPill}" Padding="8,2" Margin="0,0,8,0"
                                                        Background="{Binding SeverityBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CategoryText}" FontSize="10.5" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextHintBrush}"/>

                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding Explanation}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextHintBrush}"/>

                                            <Expander Header="{DynamicResource Diag_Lbl_Evidence}" Margin="0,8,0,0"
                                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Evidence}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextHintBrush}">
                                                                        <Run Text="{Binding Name}"/>
                                                                        <Run Text=": "/>
                                                                        <Run Text="{Binding Value}" FontWeight="SemiBold"/>
                                                                        <Run Text="{Binding Source}" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"/>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Causes}" FontSize="11" TextWrapping="Wrap" Width="360"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextHintBrush}"/>
                                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,0" Padding="10,4"
                                                        Click="OnFindingAction" Tag="{Binding}"
                                                        Content="{Binding ActionText}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding NextSteps}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextAccentBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource DiagCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{DynamicResource Diag_Lbl_History}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshHistoryCommand}"
                                Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Diag_Button_RefreshHistory}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8"
                                            CornerRadius="{DynamicResource CornerBtn}"
                                            Background="{DynamicResource BgSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding ModeText}" FontSize="10.5" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextHintBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextHintBrush}"/>
                                                <TextBlock Text="{Binding FindingsText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextHintBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportJsonCommand}"
                                    Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Diag_Button_ExportJson}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportTextCommand}"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Diag_Button_ExportText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteHistoryCommand}"
                                Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Diag_Button_DeleteHistory}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
