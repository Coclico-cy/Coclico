<UserControl x:Class="Coclico.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}" d:DesignHeight="850" d:DesignWidth="1200">

    <UserControl.Resources>

        <Style x:Key="InstallerTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Setter Property="Foreground" Value="#0A0A0C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.4" ShadowDepth="2"/>
                    </Border.Effect>
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#38BDF8"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Installer_Title}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Installer_Subtitle}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding CheckUpgradesCommand}"
                        Padding="14,8" Margin="0,0,10,0" ToolTip="{DynamicResource Installer_CheckUpgradesTooltip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_CheckUpgrades}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding UpgradeAllCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="16" Margin="0,0,8,0" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_UpgradeAll}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                        <Border Background="#33000000" CornerRadius="6" Padding="6,2" Margin="8,0,0,0"
                                Visibility="{Binding UpgradesCount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UpgradesCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="6" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">

                <RadioButton Style="{StaticResource InstallerTabStyle}"
                             GroupName="InstallerTabs"
                             IsChecked="{Binding IsTabEssentials, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="Essentials"
                             Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Star24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_TabEssentials}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource InstallerTabStyle}"
                             GroupName="InstallerTabs"
                             IsChecked="{Binding IsTabUpgrades, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="Upgrades"
                             Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_TabUpgrades}" VerticalAlignment="Center"/>
                        <Border Background="#EF4444" CornerRadius="10" Padding="7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UpgradesCount}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource InstallerTabStyle}"
                             GroupName="InstallerTabs"
                             IsChecked="{Binding IsTabSearch, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="Search">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Search24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_TabSearch}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">

            <Grid Visibility="{Binding IsTabEssentials, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="0,0,6,6"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                        <TextBlock Text="{Binding SelectedEssentialsText}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectAllEssentialsCommand}"
                                Padding="8,5" Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource Installer_SelectAll}" FontSize="11"/>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeselectAllEssentialsCommand}"
                                Padding="8,5" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Installer_DeselectAll}" FontSize="11"/>
                        </Button>

                        <Button Command="{Binding InstallSelectedEssentialsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" Foreground="White"/>
                                <TextBlock Text="{DynamicResource Installer_InstallSelected}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredEssentials}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="14,12" Margin="4,4,4,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="2" CornerRadius="6" Padding="6,2"
                                                    Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" MaxHeight="32" Margin="28,4,0,8"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Grid Grid.Row="2" Margin="28,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                       FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="1" CornerRadius="6" Padding="10,5"
                                                    Background="#0D2E1A" BorderBrush="#166534" BorderThickness="1"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✓ " FontSize="11" FontWeight="Bold" Foreground="#22C55E"/>
                                                    <TextBlock Text="{DynamicResource Installer_AlreadyInstalled}" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.InstallPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,5"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisInv}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{DynamicResource Installer_Install}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel Grid.Row="3" Margin="28,8,0,0"
                                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsTabUpgrades, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Installer_UpgradesTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#EF4444" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                    Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UpgradesCountText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Installer_UpgradesDesc}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="26,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckUpgradesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Padding="14,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Installer_ScanUpgradesBtn}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding UpgradeAllCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}"
                                Padding="16,8" Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowCircleUp24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Installer_UpgradeAll}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsCheckingUpgrades, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Width="380">
                        <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Installer_ScanningUpgrades}"
                                   FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_ScanningUpgradesDetail}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="520">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding UpgradesCount}" Value="0"/>
                                        <Condition Binding="{Binding IsCheckingUpgrades}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="30" Foreground="#10B981"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Installer_AllUpToDate}" FontSize="18" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_AllUpToDateDesc}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,6,0,18"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckUpgradesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Padding="16,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Installer_ScanUpgradesBtn}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding UpgradesCount, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding AvailableUpgrades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{DynamicResource BgElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                Margin="0,0,14,0">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                            <Border CornerRadius="6" Padding="8,3" Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="12" Margin="8,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            <Border CornerRadius="6" Padding="8,3" Background="#1A10B981"
                                                    BorderBrush="#3310B981" BorderThickness="1">
                                                <TextBlock Text="{Binding AvailableVersion}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                           Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.UpgradePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="14,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Installer_UpdateBtn}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsTabSearch, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Installer_SearchPlaceholder}"
                                KeyDown="SearchBox_KeyDown"
                                Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="18,8" ToolTip="{DynamicResource Installer_SearchBtn}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Installer_SearchBtn}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Width="360">
                        <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Installer_SearchingWinget}"
                                   FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_SearchingWingetDetail}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="540">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSearchResults}" Value="False"/>
                                        <Condition Binding="{Binding IsSearching}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Search24" FontSize="26" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Installer_SearchAnyApp}" FontSize="16" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_SearchAnyAppDesc}"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{DynamicResource BgElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                Margin="0,0,14,0">
                                            <ui:SymbolIcon Symbol="Box24" FontSize="18"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                            <Border CornerRadius="6" Padding="8,3" Background="{DynamicResource BgElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="3"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.InstallPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="14,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Installer_Install}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Installer_TerminalHeader}" FontSize="10" FontWeight="Black"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="Consolas, Courier New" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding OperationStatus}"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding ClearLogCommand}"
                                Padding="8,3" Margin="0,0,6,0" ToolTip="{DynamicResource Installer_ClearBtn}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Installer_ClearBtn}" FontSize="10.5"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelCommand}"
                                Padding="12,4" Background="#DC2626" Foreground="White" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding IsOperating, Converter={StaticResource BoolToVis}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="White" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Installer_StopBtn}" FontSize="10.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,6"
                             Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisInv}}"/>

                <Border Grid.Row="2" Background="#06090E" CornerRadius="6"
                        BorderBrush="#1E293B" BorderThickness="1" Padding="8,6" Margin="0,4,0,0">
                    <ListBox x:Name="OutputListBox" ItemsSource="{Binding OutputLog}"
                             Height="95" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="10.5"
                             Foreground="#94A3B8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>