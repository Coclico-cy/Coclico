<UserControl x:Class="Coclico.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DesignHeight="950" d:DesignWidth="1000"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BgBaseBrush}">

    <UserControl.Resources>

        <Style x:Key="NavTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{Binding TileCornerRadius}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="{Binding TilePadding}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.01" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.01" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBaseBrush}">
        <StackPanel x:Name="HomeSectionsContainer" Margin="36,28,36,40">

            <Border x:Name="SecHeader" Margin="0,0,0,20" CornerRadius="12" Padding="24,20"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Border CornerRadius="11" Margin="-24,-20" Height="70" VerticalAlignment="Top"
                            Background="{DynamicResource EclipseGlowGradient}" IsHitTestVisible="False"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Width="3" Height="26" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="1.5" Margin="0,0,12,0"/>
                                <TextBlock x:Name="WelcomeText"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" 👋" FontSize="22" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Emoji" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Dashboard_HeaderSubtitle}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="15,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:Button Click="BtnCustomizeHome_Click"
                                       Appearance="Transparent" Padding="14,9"
                                       Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                       BorderThickness="1" CornerRadius="8"
                                       Cursor="Hand" VerticalAlignment="Center" ToolTip="{DynamicResource Dashboard_CustomizeTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PaintBrush24" FontSize="13" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common_Customize}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="SecMetrics" Margin="0,0,0,20"
                    CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="12,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{DynamicResource Dashboard_MetricCpu}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuUsageText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4"/>

                    <StackPanel Grid.Column="2" Margin="16,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{DynamicResource Dashboard_MetricRam}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RamUsageText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4"/>

                    <StackPanel Grid.Column="4" Margin="16,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{DynamicResource Dashboard_MetricStorage}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DiskUsageText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="5" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4"/>

                    <StackPanel Grid.Column="6" Margin="16,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{DynamicResource Dashboard_MetricUptime}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextHintBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UptimeText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SecQuickModes" Margin="0,0,0,20"
                    CornerRadius="{Binding CardCornerRadius}"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="11" Foreground="{DynamicResource ArchitecturalYellowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="MODES SYSTÈME 1-CLIC" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource NavTileStyle}"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                MouseLeftButtonUp="ModeZen_Click">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource GradZen}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dashboard_ModeZen}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Dashboard_TileRam_Desc}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Margin="3,0,3,0" Style="{StaticResource NavTileStyle}"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                MouseLeftButtonUp="ModeGamer_Click">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource GradGamer}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dashboard_ModeGamer}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Dashboard_ModeGamer_Desc}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource NavTileStyle}"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                MouseLeftButtonUp="ModeWork_Click">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource GradWork}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Briefcase24" FontSize="16" Foreground="#10B981"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Dashboard_ModeWork}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Dashboard_ModeWork_Desc}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="SecCoreTiles" Margin="0,0,0,20">
                <UniformGrid x:Name="CoreTilesGrid" Columns="{Binding GridColumns}">

                    <Border x:Name="TileRam" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTileRam, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TileRam_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradRam}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="Memory16" FontSize="18" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_RamCleaner}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TileRam_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TileCleaning" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTileCleaning, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TileCleaning_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradCleaning}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="#10B981"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_Cleaning}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TileCleaning_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TilePrograms" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTilePrograms, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TilePrograms_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradPrograms}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="{DynamicResource SecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_Programs}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TilePrograms_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TileInstaller" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTileInstaller, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TileInstaller_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradInstaller}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource ArchitecturalAmberBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_Installer}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TileInstaller_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TileHealth" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTileHealth, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TileHealth_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradHealth}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_HealthDefense}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TileHealth_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TileNetwork" Style="{StaticResource NavTileStyle}"
                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding ShowTileNetwork, Converter={StaticResource BoolToVis}}"
                            MouseLeftButtonUp="TileNetwork_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="{Binding IconCornerRadius}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GradNetwork}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{DynamicResource Menu_Network}"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_TileNetwork_Desc}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                </UniformGrid>
            </Border>

            <Border x:Name="SecCustomShortcuts" Margin="0,0,0,20"
                    CornerRadius="{Binding CardCornerRadius}"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Dashboard_CustomShortcuts}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Click="BtnAddShortcut_Click"
                                   Appearance="Transparent" Padding="10,5"
                                   Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                   CornerRadius="{Binding TileCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Dashboard_AddShortcut}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CustomShortcuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" Margin="0,0,10,10"
                                        CornerRadius="{Binding DataContext.TileCornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="10,8" Cursor="Hand"
                                        MouseLeftButtonUp="CustomShortcut_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource BgSurfaceBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Click="BtnDeleteShortcut_Click" Tag="{Binding Id}"
                                                   Appearance="Transparent" Padding="4" Margin="2,0,0,0"
                                                   VerticalAlignment="Top" ToolTip="{DynamicResource Common_Delete}">
                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" Foreground="{DynamicResource TextHintBrush}"/>
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Dashboard_CustomShortcuts_Empty}"
                               FontSize="11" Foreground="{DynamicResource TextHintBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Visibility="{Binding HasNoShortcuts, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border x:Name="SecRecentActivity" Margin="0,0,0,20"
                    CornerRadius="{Binding CardCornerRadius}"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="{DynamicResource TextHintBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Dashboard_RecentActivity_Title}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="14" CornerRadius="2" Margin="0,0,10,0"
                                            Background="{Binding AccentColor}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeText}"
                                               FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Dashboard_RecentActivity_Empty}"
                               FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding HasNoActivities, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>