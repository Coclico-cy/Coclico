<ui:FluentWindow x:Class="Coclico.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Coclico - Mise à jour disponible"
        Width="520" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,48,24,8" Background="{DynamicResource ApplicationBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="24" Foreground="#38BDF8"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Mise à jour disponible" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="VersionLine" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,8" Padding="12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nouveautés de cette version :" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ProgressBar x:Name="DownloadProgress" Grid.Row="2" Height="6" Margin="24,4,24,4"
                     Visibility="Collapsed"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>

        <Border Grid.Row="3" Padding="24,12,24,24" Background="{DynamicResource ApplicationBackgroundBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSkip" Grid.Column="0" Content="Ignorer cette version" Click="BtnSkip_Click"
                            Margin="0,0,10,0" Padding="16,8"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button x:Name="BtnLater" Grid.Column="1" Content="Plus tard" Click="BtnLater_Click"
                            Margin="0,0,10,0" Padding="16,8"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button x:Name="BtnInstall" Grid.Column="2" Content="Télécharger et installer" Click="BtnInstall_Click"
                            Padding="16,8" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>