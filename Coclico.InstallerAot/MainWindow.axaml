<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ico="using:Coclico.Installer"
        xmlns:models="using:Coclico.Installer.Models"
        x:Class="Coclico.Installer.MainWindow"
        Title="Installation de Coclico"
        Width="920" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BgBaseBrush}"
        Opened="Window_Opened">
  <Window.Styles>
    <Style Selector="Ellipse.ambientRed">
      <Style.Animations>
        <Animation Duration="0:0:10" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Canvas.Left" Value="-120"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Canvas.Left" Value="-60"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.ambientOrange">
      <Style.Animations>
        <Animation Duration="0:0:13" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Canvas.Top" Value="-100"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Canvas.Top" Value="-160"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.ambientYellow">
      <Style.Animations>
        <Animation Duration="0:0:16" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Canvas.Left" Value="600"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Canvas.Left" Value="550"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Border BorderBrush="#2A2228" BorderThickness="1" CornerRadius="8">
    <Grid Background="{DynamicResource BgBaseBrush}">
      <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.30">
        <Ellipse Width="500" Height="320" Canvas.Left="-120" Canvas.Top="-120" Classes="ambientRed">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FF3B30" Offset="0"/>
              <GradientStop Color="#4A110D" Offset="0.45"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="450" Height="320" Canvas.Left="420" Canvas.Top="-100" Classes="ambientOrange">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FF6B35" Offset="0"/>
              <GradientStop Color="#451C0A" Offset="0.45"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="400" Height="280" Canvas.Left="600" Canvas.Top="280" Classes="ambientYellow">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFA000" Offset="0"/>
              <GradientStop Color="#3D2100" Offset="0.45"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Canvas>

      <Grid RowDefinitions="Auto,*">
        <Border x:Name="TitleBarBorder" Grid.Row="0" Height="40" Background="#0C0D12"
                PointerPressed="TitleBar_PointerPressed">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <Image Grid.Column="0" Source="avares://Coclico.Installer/Resources/plage.png"
                   Width="18" Height="18" Margin="14,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtHeaderTitle" Grid.Column="1" Text="Coclico" FontWeight="SemiBold"
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Border Grid.Column="2" Background="#161822" CornerRadius="8" BorderBrush="#2B2D3A"
                    BorderThickness="1" Padding="2" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnLangFr" Classes="lang" Content="Français" Click="BtnLangFr_Click"/>
                <Button x:Name="BtnLangEn" Classes="lang" Content="English" Click="BtnLangEn_Click"/>
              </StackPanel>
            </Border>
            <Button Grid.Column="4" Classes="titlebarBtn" Content="&#x2013;" Click="BtnMinimize_Click"
                    FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button Grid.Column="5" Classes="titlebarBtn close" Content="&#x2715;" Click="BtnClose_Click"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
          <Border Grid.Column="0" Background="#0C0D12" BorderBrush="#1F1A22" BorderThickness="0,0,1,0" Padding="20,24">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Grid.Row="0" Margin="0,0,0,24" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#181922"
                        BorderBrush="#2D2E38" BorderThickness="1" Margin="0,0,10,0">
                  <Image Source="avares://Coclico.Installer/Resources/plage.png" Width="24" Height="24"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Coclico" FontSize="16" FontWeight="Bold"/>
                  <TextBlock Text="Assistant Setup" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Border x:Name="StepItem1" Background="#1C1822" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum1" Text="1" FontWeight="Bold" FontSize="11.5" Foreground="#FF6B35" Width="20"/>
                    <TextBlock x:Name="StepLabel1" Text="Bienvenue" FontSize="12.5" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem2" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum2" Text="2" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel2" Text="Licence" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem3" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum3" Text="3" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel3" Text="Dossier" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem4" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum4" Text="4" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel4" Text="Composants &amp; IA" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem5" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum5" Text="5" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel5" Text="Prêt à installer" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem6" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum6" Text="6" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel6" Text="Installation" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
                <Border x:Name="StepItem7" Background="Transparent" CornerRadius="8" Padding="10,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StepNum7" Text="7" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                    <TextBlock x:Name="StepLabel7" Text="Terminé" FontSize="12.5" Foreground="#888"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Column="1" Margin="28,16,28,20" RowDefinitions="*,Auto">
            <Grid x:Name="ViewStepWelcome" Grid.Row="0" IsVisible="True">
              <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TxtWelcomeTitle" Text="Bienvenue dans l'installation de Coclico"
                           FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtWelcomeDesc" Text="Cet assistant va installer Coclico sur votre ordinateur en quelques étapes."
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="16,14">
                  <StackPanel>
                    <TextBlock Text="Vérification des Prérequis Système" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                      <PathIcon x:Name="DotNetIcon" Grid.Column="0" Data="{x:Static ico:Ico.CheckCircle}"
                                Foreground="#10B981" Width="18" Height="18" Margin="0,0,10,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDotNetTitle" Text="Runtime .NET 10 Desktop" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtDotNetStatus" Text="Détection en cours..." FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <Border x:Name="DotNetPill" Grid.Column="2" Background="#11291F" CornerRadius="6"
                              Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDotNetBadge" Text="OK" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                      </Border>
                    </Grid>

                    <Border Classes="sep" Margin="0,4,0,10"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <PathIcon x:Name="GpuIcon" Grid.Column="0" Data="{x:Static ico:Ico.Desktop}"
                                Foreground="#10B981" Width="18" Height="18" Margin="0,0,10,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGpuTitle" Text="Carte Graphique (GPU)" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtGpuStatus" Text="Détection en cours..." FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <Border x:Name="GpuPill" Grid.Column="2" Background="#11291F" CornerRadius="6"
                              Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGpuBadge" Text="CUDA PRÊT" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="ViewStepLicense" Grid.Row="0" IsVisible="False" RowDefinitions="Auto,*,Auto">
              <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TxtLicenseTitle" Text="Contrat de Licence Logicielle" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="TxtLicenseDesc" Text="Veuillez lire attentivement les termes de la licence MIT ci-dessous :"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border Grid.Row="1" Background="#0A0B0F" CornerRadius="10" BorderBrush="#252630"
                      BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBox x:Name="TxtLicenseBox" Background="Transparent" Foreground="#BBB" BorderThickness="0"
                           IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas,Segoe UI" FontSize="11.5"
                           MinHeight="240"/>
                </ScrollViewer>
              </Border>
              <CheckBox x:Name="ChkAcceptLicense" Grid.Row="2" Content="J'accepte les termes du contrat de licence"
                        FontSize="12.5" Checked="ChkAcceptLicense_Changed" Unchecked="ChkAcceptLicense_Changed"/>
            </Grid>

            <Grid x:Name="ViewStepLocation" Grid.Row="0" IsVisible="False">
              <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TxtLocationTitle" Text="Dossier de Destination" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtLocationDesc" Text="Choisissez le dossier dans lequel installer Coclico :"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                        Padding="16,14" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Emplacement cible" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="36" FontSize="12" IsReadOnly="True"/>
                      <Button x:Name="BtnBrowse" Grid.Column="1" Classes="secondary" Content="Parcourir..."
                              Height="36" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Background="#12131A" CornerRadius="12" BorderBrush="#252630" BorderThickness="1" Padding="16,14">
                  <StackPanel>
                    <TextBlock x:Name="TxtLocationPrivacy"
                               Text="Installation utilisateur isolée (%LocalAppData%). Aucune élévation administrateur requise."
                               FontSize="11.5" Foreground="#AAA" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Border Classes="sep" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtSpaceRequired" Text="Espace disque requis : ~350 Mo" FontSize="11.5" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSpaceAvailable" Text="Espace libre sur le disque : 180 Go"
                               FontSize="11.5" Foreground="#10B981"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="ViewStepComponents" Grid.Row="0" IsVisible="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Top">
                  <TextBlock x:Name="TxtComponentsTitle" Text="Composants &amp; Modèles d'IA" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                  <TextBlock x:Name="TxtComponentsDesc" Text="Personnalisez les composants à inclure dans votre installation :"
                             FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                  <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10"
                          BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                          Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox Grid.Column="0" IsChecked="True" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCompCoreTitle" Text="Application Coclico (Obligatoire)" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock x:Name="TxtCompCoreDesc" Text="Gestionnaire système, diagnostic, optimisation et sécurité Windows."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="~350 Mo" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10"
                          BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                          Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox x:Name="ChkCuda" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                Checked="OnComponentCheckChanged" Unchecked="OnComponentCheckChanged"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCompCudaTitle" Text="Runtime NVIDIA CUDA 12" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock x:Name="TxtCompCudaDesc" Text="Accélération GPU RTX / GTX maximale pour l'IA locale."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="~1.1 Go" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10"
                          BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                          Padding="14,10" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox x:Name="ChkAiModel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                Checked="OnAiModelCheckChanged" Unchecked="OnAiModelCheckChanged"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCompAiTitle" Text="Modèle IA Local Coclico Copilot" FontWeight="Bold" FontSize="12.5"/>
                        <ComboBox x:Name="CmbAiModel" Margin="0,4,0,0" FontSize="12" IsEnabled="False"
                                  SelectionChanged="CmbAiModel_SelectionChanged">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:InstallerAiModel">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                                <TextBlock Text=" - " FontSize="12" Foreground="#666" Margin="4,0,4,0"/>
                                <TextBlock Text="{Binding SizeMb, StringFormat='{}{0} Mo'}" FontSize="11" Foreground="#888"/>
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="TxtCompAiDesc" Text="Sélectionnez un modèle à télécharger pour l'utiliser sans connexion internet."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtAiModelSize" Grid.Column="2" Text="~1.1 Go" FontSize="11"
                                 FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <TextBlock x:Name="TxtOptionsGroupTitle" Text="Raccourcis &amp; Démarrage" FontSize="12" FontWeight="Bold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                  <CheckBox x:Name="ChkDesktop" Content="Créer une icône sur le Bureau" IsChecked="True" Margin="0,0,0,6"/>
                  <CheckBox x:Name="ChkStartMenu" Content="Ajouter au menu Démarrer" IsChecked="True" Margin="0,0,0,6"/>
                  <CheckBox x:Name="ChkAutoLaunch" Content="Lancer Coclico à la fermeture de l'installeur" IsChecked="True"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="ViewStepSummary" Grid.Row="0" IsVisible="False">
              <StackPanel VerticalAlignment="Top">
                <TextBlock x:Name="TxtSummaryTitle" Text="Prêt à installer" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtSummaryDesc" Text="Vérifiez vos paramètres avant de commencer l'installation :"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="16,14">
                  <StackPanel>
                    <TextBlock x:Name="TxtSummaryDestLabel" Text="Dossier de destination :" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtSummaryPath" Text="C:\..." FontSize="12" Margin="0,2,0,12"/>

                    <TextBlock x:Name="TxtSummaryComponentsLabel" Text="Composants sélectionnés :" FontSize="11.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtSummaryComponentsList" Text="• Application Coclico Core" FontSize="12" Margin="0,2,0,12"/>

                    <Border Classes="sep" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtSummaryTotalSpace" Text="Espace disque total requis : ~350 Mo"
                               FontSize="12" FontWeight="Bold" Foreground="#FF6B35"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="ViewStepInstalling" Grid.Row="0" IsVisible="False" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" Width="520">
                <Border Width="72" Height="72" CornerRadius="18" Background="#181922"
                        BorderBrush="#352825" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                  <Image Source="avares://Coclico.Installer/Resources/plage.png" Width="46" Height="46"/>
                </Border>

                <TextBlock x:Name="TxtInstallingTitle" Text="Installation de Coclico en cours..." FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtInstallingDesc" Text="Veuillez patienter pendant la configuration des fichiers..."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,20" ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="TxtProgressStatus" Text="Préparation..." FontSize="11.5"
                             Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11.5" FontWeight="Bold"
                             Foreground="#FF6B35" Grid.Column="1"/>
                </Grid>

                <Border Background="#12131A" CornerRadius="10" BorderBrush="#252630" BorderThickness="1" Padding="14,10">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <PathIcon Data="{x:Static ico:Ico.Sparkle}" Foreground="#FFA000" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtTip" Text="Astuce : Coclico nettoie la mémoire et les caches système en un clic."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Grid x:Name="ViewStepFinish" Grid.Row="0" IsVisible="False" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" Width="560">
                <Border Width="84" Height="84" CornerRadius="42" Background="#11291F"
                        BorderBrush="#1C4B37" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                  <PathIcon Data="{x:Static ico:Ico.Heart}" Foreground="#10B981" Width="38" Height="38"/>
                </Border>

                <TextBlock x:Name="TxtFinishTitle" Text="Merci d'avoir installé Coclico !" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtFinishDesc" Text="Coclico a été installé avec succès sur votre ordinateur."
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                        Padding="18,16" Margin="0,0,0,14">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                      <PathIcon Data="{x:Static ico:Ico.Heart}" Foreground="#FF6B35" Width="16" Height="16" Margin="0,0,8,0"/>
                      <TextBlock x:Name="TxtFinishThanksTitle" Text="Un immense merci pour votre confiance"
                                 FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtFinishThanksDesc"
                               Text="Choisir Coclico, c'est apporter un soutien immense à ce projet. Savoir que l'application est utilisée est la plus belle des motivations, et votre confiance donne tout son sens au travail accompli. Merci de faire partie de l'aventure !"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="17"/>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="TxtFinishNote" Text="Vous pouvez maintenant lancer l'application et profiter de ses fonctionnalités."
                           FontSize="12" Foreground="#888" TextAlignment="Center" Margin="0,0,0,24"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button x:Name="BtnFinishClose" Classes="secondary" Content="Fermer" Width="120" Margin="0,0,12,0"
                          Click="BtnFinishClose_Click"/>
                  <Button x:Name="BtnLaunchApp" Classes="accent" Content="Lancer Coclico" Width="180" Click="BtnLaunchApp_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid x:Name="ViewStepUninstall" Grid.Row="0" IsVisible="False" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" Width="480">
                <Border Width="64" Height="64" CornerRadius="16" Background="#261A1D" BorderBrush="#4A252B"
                        BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <PathIcon Data="{x:Static ico:Ico.Delete}" Foreground="#FF453A" Width="28" Height="28"/>
                </Border>
                <TextBlock x:Name="TxtUninstallTitle" Text="Désinstaller Coclico" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtUninstallDesc"
                           Text="Voulez-vous vraiment désinstaller Coclico ?&#x0a;Vos réglages et données personnelles seront conservés."
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                           LineHeight="18" Margin="0,0,0,20"/>
                <ProgressBar x:Name="UninstallProgress" Height="6" Minimum="0" Maximum="100" IsVisible="False"
                             Margin="0,0,0,20" Foreground="#FF453A"/>
                <StackPanel x:Name="UninstallButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button x:Name="BtnCancelUninstall" Classes="secondary" Content="Annuler" Width="120" Margin="0,0,10,0"
                          Click="BtnCancel_Click"/>
                  <Button x:Name="BtnDoUninstall" Classes="danger" Content="Désinstaller" Width="140"
                          Click="BtnDoUninstall_Click"/>
                </StackPanel>
                <Button x:Name="BtnFinishUninstalled" Classes="secondary" Content="Fermer" Width="120" IsVisible="False"
                        HorizontalAlignment="Center" Click="BtnFinishClose_Click"/>
              </StackPanel>
            </Grid>

            <Grid x:Name="NavBar" Grid.Row="1" Margin="0,16,0,0">
              <Button x:Name="BtnCancel" Classes="secondary" Content="Annuler" HorizontalAlignment="Left"
                      Width="100" Height="38" Click="BtnCancel_Click"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Classes="secondary" Content="&lt; Précédent" Width="120" Height="38"
                        Margin="0,0,10,0" IsVisible="False" Click="BtnBack_Click"/>
                <Button x:Name="BtnNext" Classes="accent" Content="Suivant &gt;" Width="130" Height="38"
                        Click="BtnNext_Click"/>
              </StackPanel>
            </Grid>

          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
