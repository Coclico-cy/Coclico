<ui:FluentWindow x:Class="Coclico.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Installation de Coclico (Bêta)" Height="640" Width="920"
        MinHeight="640" MinWidth="920" MaxHeight="640" MaxWidth="920"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource BgBaseBrush}"
        BorderBrush="#2A2228"
        BorderThickness="1"
        Icon="Resources/plage.ico"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="AmbientRedTransform" Storyboard.TargetProperty="X"
                                     From="-40" To="60" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="AmbientOrangeTransform" Storyboard.TargetProperty="Y"
                                     From="30" To="-60" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="AmbientYellowTransform" Storyboard.TargetProperty="X"
                                     From="50" To="-50" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{DynamicResource BgBaseBrush}">
        <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.30">
            <Ellipse Width="500" Height="320" Canvas.Left="-120" Canvas.Top="-120">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF3B30" Offset="0"/>
                        <GradientStop Color="#4A110D" Offset="0.45"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmbientRedTransform"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="450" Height="320" Canvas.Left="420" Canvas.Top="-100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF6B35" Offset="0"/>
                        <GradientStop Color="#451C0A" Offset="0.45"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmbientOrangeTransform"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="400" Height="280" Canvas.Left="600" Canvas.Top="280">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFA000" Offset="0"/>
                        <GradientStop Color="#3D2100" Offset="0.45"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmbientYellowTransform"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Coclico Setup"
                         ShowMaximize="False" ShowMinimize="True" Padding="14,6">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/plage.png" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Coclico Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>

                        <Border Background="#331A12" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" BorderBrush="#6B2E1E" BorderThickness="1" Margin="0,0,14,0">
                            <TextBlock x:Name="TxtBetaBadge" Text="BÊTA" FontSize="10.5" FontWeight="Bold" Foreground="#FF6B35"/>
                        </Border>

                        <Border Background="#161822" CornerRadius="8" BorderBrush="#2B2D3A" BorderThickness="1" Padding="2" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLangFr" Content="Français" FontSize="11" FontWeight="SemiBold" Width="70" Height="28"
                                        Background="#FF453A" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnLangFr_Click" Padding="6,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnLangEn" Content="English" FontSize="11" FontWeight="SemiBold" Width="70" Height="28"
                                        Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand" Click="BtnLangEn_Click" Padding="6,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0C0D12" BorderBrush="#1F1A22" BorderThickness="0,0,1,0" Padding="20,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#181922"
                                        BorderBrush="#2D2E38" BorderThickness="1" Margin="0,0,10,0">
                                    <Image Source="Resources/plage.png" Width="24" Height="24"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Coclico" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Assistant Setup" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <Border x:Name="StepItem1" Background="#1C1822" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum1" Text="1" FontWeight="Bold" FontSize="11.5" Foreground="#FF6B35" Width="20"/>
                                    <TextBlock x:Name="StepLabel1" Text="Bienvenue" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem2" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum2" Text="2" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel2" Text="Licence" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem3" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum3" Text="3" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel3" Text="Dossier" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem4" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum4" Text="4" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel4" Text="Composants &amp; IA" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem5" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum5" Text="5" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel5" Text="Prêt à installer" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem6" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum6" Text="6" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel6" Text="Installation" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StepItem7" Background="Transparent" CornerRadius="8" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StepNum7" Text="7" FontWeight="Bold" FontSize="11.5" Foreground="#666" Width="20"/>
                                    <TextBlock x:Name="StepLabel7" Text="Terminé" FontSize="12.5" Foreground="#888"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#161217" CornerRadius="10" Padding="10,8" BorderBrush="#302028" BorderThickness="1">
                            <TextBlock Text="Version Bêta" FontWeight="Bold" FontSize="11" Foreground="#FF6B35" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="28,16,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid x:Name="ViewStepWelcome" Visibility="Visible">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="TxtWelcomeTitle" Text="Bienvenue dans l'installation de Coclico" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtWelcomeDesc" Text="Cet assistant va installer Coclico sur votre ordinateur en quelques étapes." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Border Background="#1C1412" CornerRadius="12" BorderBrush="#4A261D" BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="22" Foreground="#FF6B35" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Version Bêta Expérimentale" FontWeight="Bold" FontSize="12.5" Foreground="#FF9E80"/>
                                            <TextBlock x:Name="TxtBetaNotice" Text="Coclico est actuellement en version Bêta. Vos retours et rapports de bugs sont les bienvenus." FontSize="11.5" Foreground="#CCC" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Vérification des Prérequis Système" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon x:Name="DotNetIcon" Symbol="CheckmarkCircle24" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDotNetTitle" Text="Runtime .NET 10 Desktop" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtDotNetStatus" Text="Détection en cours..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border x:Name="DotNetPill" Grid.Column="2" Background="#11291F" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDotNetBadge" Text="OK" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                        </Grid>

                                        <Separator Background="#222" Margin="0,4,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon x:Name="GpuIcon" Symbol="Desktop24" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtGpuTitle" Text="Carte Graphique (GPU)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtGpuStatus" Text="Détection en cours..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border x:Name="GpuPill" Grid.Column="2" Background="#11291F" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtGpuBadge" Text="CUDA PRÊT" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ViewStepLicense" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtLicenseTitle" Text="Contrat de Licence Logicielle" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtLicenseDesc" Text="Veuillez lire attentivement les termes de la licence MIT ci-dessous :" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#0A0B0F" CornerRadius="10" BorderBrush="#252630" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtLicenseBox" Background="Transparent" Foreground="#BBB" BorderThickness="0"
                                             IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Segoe UI" FontSize="11.5"/>
                                </ScrollViewer>
                            </Border>
                            <CheckBox x:Name="ChkAcceptLicense" Grid.Row="2" Content="J'accepte les termes du contrat de licence"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" Checked="ChkAcceptLicense_Changed" Unchecked="ChkAcceptLicense_Changed"/>
                        </Grid>

                        <Grid x:Name="ViewStepLocation" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="TxtLocationTitle" Text="Dossier de Destination" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLocationDesc" Text="Choisissez le dossier dans lequel installer Coclico :" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Emplacement cible" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtInstallPath" Height="36" FontSize="12"
                                                     Background="#0D0E13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="#252630" BorderThickness="1" Padding="10,0"
                                                     VerticalContentAlignment="Center" IsReadOnly="True"/>
                                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Parcourir..." Height="36" Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,0" Click="BtnBrowse_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Background="#12131A" CornerRadius="12" BorderBrush="#252630" BorderThickness="1" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLocationPrivacy" Text="Installation utilisateur isolée (%LocalAppData%). Aucune élévation administrateur requise." FontSize="11.5" Foreground="#AAA" Margin="0,0,0,10"/>
                                        <Separator Background="#222" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtSpaceRequired" Text="Espace disque requis : ~350 Mo" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="TxtSpaceAvailable" Text="Espace libre sur le disque : 180 Go" FontSize="11.5" Foreground="#10B981"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ViewStepComponents" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="TxtComponentsTitle" Text="Composants &amp; Modèles d'IA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtComponentsDesc" Text="Personnalisez les composants à inclure dans votre installation :" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCompCoreTitle" Text="Application Coclico (Obligatoire)" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtCompCoreDesc" Text="Gestionnaire système, diagnostic, optimisation et sécurité Windows." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="~350 Mo" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ChkCuda" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnComponentCheckChanged" Unchecked="OnComponentCheckChanged"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCompCudaTitle" Text="Runtime NVIDIA CUDA 12" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtCompCudaDesc" Text="Accélération GPU RTX / GTX maximale pour l'IA locale." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="~1.1 Go" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ChkAiModel" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnAiModelCheckChanged" Unchecked="OnAiModelCheckChanged"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCompAiTitle" Text="Modèle IA Local Coclico Copilot" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <ComboBox x:Name="CmbAiModel"
                                                          Margin="0,4,0,0"
                                                          FontSize="12"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          Background="#0D0E13"
                                                          BorderBrush="#252630"
                                                          BorderThickness="1"
                                                          VerticalAlignment="Center"
                                                          SelectionChanged="CmbAiModel_SelectionChanged"
                                                          IsEnabled="False">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text=" - " FontSize="12" Foreground="#666" Margin="4,0,4,0"/>
                                                                <TextBlock Text="{Binding SizeMb, StringFormat='{}{0} Mo'}" FontSize="11" Foreground="#888"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock x:Name="TxtCompAiDesc" Text="Sélectionnez un modèle à télécharger pour l'utiliser sans connexion internet." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtAiModelSize" Grid.Column="2" Text="~1.1 Go" FontSize="11" FontWeight="SemiBold" Foreground="#888" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="TxtOptionsGroupTitle" Text="Raccourcis &amp; Démarrage" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                                    <CheckBox x:Name="ChkDesktop" Content="Créer une icône sur le Bureau" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkStartMenu" Content="Ajouter au menu Démarrer" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkAutoLaunch" Content="Lancer Coclico à la fermeture de l'installeur" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="ViewStepSummary" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="TxtSummaryTitle" Text="Prêt à installer" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtSummaryDesc" Text="Vérifiez vos paramètres avant de commencer l'installation :" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSummaryDestLabel" Text="Dossier de destination :" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtSummaryPath" Text="C:\..." FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12"/>

                                        <TextBlock x:Name="TxtSummaryComponentsLabel" Text="Composants sélectionnés :" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TxtSummaryComponentsList" Text="• Application Coclico Core" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" LineHeight="18"/>

                                        <Separator Background="#222" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="TxtSummaryTotalSpace" Text="Espace disque total requis : ~350 Mo" FontSize="12" FontWeight="Bold" Foreground="#FF6B35"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ViewStepInstalling" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Width="520">
                                <Border Width="72" Height="72" CornerRadius="18" Background="#181922"
                                        BorderBrush="#352825" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Image Source="Resources/plage.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <TextBlock x:Name="TxtInstallingTitle" Text="Installation de Coclico en cours..." FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtInstallingDesc" Text="Veuillez patienter pendant la configuration des fichiers..." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#191B24" Foreground="{DynamicResource AccentCyanBrush}" BorderThickness="0" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,20">
                                    <TextBlock x:Name="TxtProgressStatus" Text="Préparation..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11.5" FontWeight="Bold" Foreground="#FF6B35" HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Background="#12131A" CornerRadius="10" BorderBrush="#252630" BorderThickness="1" Padding="14,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="#FFA000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTip" Text="Astuce : Coclico nettoie la mémoire et les caches système en un clic." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ViewStepFinish" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Width="560">
                                <Border Width="84" Height="84" CornerRadius="42" Background="#11291F"
                                        BorderBrush="#1C4B37" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <ui:SymbolIcon Symbol="Heart24" FontSize="38" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="TxtFinishTitle" Text="Merci d'avoir installé Coclico !" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtFinishDesc" Text="Coclico a été installé avec succès sur votre ordinateur." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,0,0,18"/>

                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                                        BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                                        Padding="18,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="#FF6B35" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtFinishThanksTitle" Text="Un immense merci pour votre confiance" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtFinishThanksDesc" Text="Choisir Coclico, c'est apporter un soutien immense à ce projet. Savoir que l'application est utilisée est la plus belle des motivations, et votre confiance donne tout son sens au travail accompli. Merci de faire partie de l'aventure !"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="TxtFinishNote" Text="Vous pouvez maintenant lancer l'application et profiter de ses fonctionnalités." FontSize="12" Foreground="#888" TextAlignment="Center" Margin="0,0,0,24"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnFinishClose" Content="Fermer" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,12,0" Click="BtnFinishClose_Click"/>
                                    <Button x:Name="BtnLaunchApp" Content="Lancer Coclico" Style="{StaticResource AccentButtonStyle}" Width="180" Click="BtnLaunchApp_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ViewStepUninstall" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Width="480">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#261A1D" BorderBrush="#4A252B" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="28" Foreground="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtUninstallTitle" Text="Désinstaller Coclico" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtUninstallDesc" Text="Voulez-vous vraiment désinstaller Coclico ?&#x0a;Vos réglages et données personnelles seront conservés." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>
                                <ProgressBar x:Name="UninstallProgress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,20" Background="#191B24" Foreground="#FF453A" BorderThickness="0"/>
                                <StackPanel x:Name="UninstallButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnCancelUninstall" Content="Annuler" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                                    <Button x:Name="BtnDoUninstall" Content="Désinstaller" Style="{StaticResource AccentButtonStyle}" Background="#B91C1C" Width="140" Click="BtnDoUninstall_Click"/>
                                </StackPanel>
                                <Button x:Name="BtnFinishUninstalled" Content="Fermer" Style="{StaticResource SecondaryButtonStyle}" Width="120" Visibility="Collapsed" HorizontalAlignment="Center" Click="BtnFinishClose_Click"/>
                            </StackPanel>
                        </Grid>

                    </Grid>

                    <Grid x:Name="NavBar" Grid.Row="1" Margin="0,16,0,0">
                        <Button x:Name="BtnCancel" Content="Annuler" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Width="100" Height="38" Padding="0" Click="BtnCancel_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBack" Content="&lt; Précédent" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="120" Height="38" Margin="0,0,10,0" Padding="0" Click="BtnBack_Click" Visibility="Collapsed"/>
                            <Button x:Name="BtnNext" Content="Suivant &gt;" Style="{StaticResource AccentButtonStyle}"
                                    Width="130" Height="38" Padding="0" Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>