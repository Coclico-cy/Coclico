<ui:FluentWindow x:Class="Coclico.Installer.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Désinstaller Coclico" Height="700" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgBaseBrush}"
        BorderBrush="#2A2228" BorderThickness="1"
        Icon="pack://application:,,,/Coclico.Installer;component/Resources/plage.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
        <SolidColorBrush x:Key="DangerLightBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="AmbientRedTransform" Storyboard.TargetProperty="X"
                                     From="-30" To="40" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{DynamicResource BgBaseBrush}">
        <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity="0.22">
            <Ellipse Width="600" Height="420" Canvas.Left="-160" Canvas.Top="-140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF453A" Offset="0"/>
                        <GradientStop Color="#4A110D" Offset="0.45"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AmbientRedTransform"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="56" Height="56" CornerRadius="14" Background="#261A1D"
                        BorderBrush="#FF453A" BorderThickness="1.5" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Coclico.Installer;component/Resources/plage.png" Width="34" Height="34"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUnTitle" Text="Désinstallation complète de Coclico"
                               FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtUnSubtitle" Text="Cette fenêtre supprime l'application, vos données et toutes ses traces sur le système."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="PanelMain" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#261A1D" CornerRadius="10" BorderBrush="#FF453A" BorderThickness="1"
                        Padding="14,10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtUnWarning" Text="ATTENTION : cette opération est définitive. Aucune sauvegarde ne sera effectuée."
                                   FontWeight="SemiBold" FontSize="12" Foreground="#FF9E80" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock x:Name="TxtUnListTitle" Text="Les éléments suivants seront supprimés de manière permanente :"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#261A1D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="15" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnItem1" Text="Dossier d'installation" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtInstallPath" Text="C:\...\Coclico" FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#261A1D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="15" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnItem2" Text="Raccourcis Bureau et Menu Démarrer" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Coclico.lnk" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#261A1D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="15" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnItem3" Text="Données et configuration" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="%AppData%\Coclico\  ·  %LocalAppData%\Coclico\" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#261A1D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Database24" FontSize="15" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnItem4" Text="Entrées de registre Windows" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Applications et fonctionnalités · Applications installées" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="#261A1D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnItem5" Text="Cache et fichiers temporaires" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="%TEMP%\Coclico\*" FontSize="11" Foreground="#888"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#12131A" CornerRadius="10" BorderBrush="#252630" BorderThickness="1" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtProgressStatus" Text="Prêt à désinstaller." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtProgressPercent" Text="" FontSize="11.5" FontWeight="Bold" Foreground="#FF6B35" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="UninstallProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                                 Background="#191B24" Foreground="{StaticResource DangerBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <CheckBox x:Name="ChkKeepUserData" Margin="0,0,0,8"
                              Content="Conserver mes données (profils, réglages, modèles IA)"
                              FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox x:Name="ChkConfirmCompleteRemoval" Margin="0,0,0,14"
                              Content="Je comprends que TOUTES les données Coclico seront supprimées définitivement et je confirme la désinstallation."
                              FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelUninstall" Content="Annuler"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110" Height="38" Margin="0,0,10,0"
                                Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnStartUninstall" Content="Désinstaller TOUT"
                                Style="{StaticResource DangerButtonStyle}"
                                Width="170" Height="38"
                                Click="BtnStartUninstall_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelGoodbye" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Width="520">
                    <Border Width="84" Height="84" CornerRadius="42" Background="#11291F"
                            BorderBrush="#1C4B37" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <ui:SymbolIcon Symbol="Heart24" FontSize="38" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TxtUnByeTitle" Text="Merci d'avoir utilisé Coclico !"
                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtUnByeDesc" Text="La désinstallation est terminée : l'application, vos données, les raccourcis et les entrées de registre ont été supprimés avec succès."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtUnByeFooter" Text="Nous espérons vous revoir très bientôt. Bonne continuation !"
                               FontSize="13" FontWeight="SemiBold" Foreground="#FF6B35"
                               TextAlignment="Center" Margin="0,0,0,22"/>

                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                            Padding="16,12" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Coclico" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="Créé et développé par Coclico" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Fermer" Style="{StaticResource AccentButtonStyle}"
                            Width="150" Height="40" HorizontalAlignment="Center" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>