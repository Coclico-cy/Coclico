## .gitignore pour projet C# WPF (Coclico)

# Build outputs
[Bb]in/
[Oo]bj/
out/
build/
dist/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Rider / JetBrains
.idea/
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
nuget.config

# Test results
TestResults/
**/TestResults/
*.trx
*.coverage
*.coveragexml

# Publish & Installer output
publish/
artifacts/
*.pubxml
*.pubxml.user

# Installer build intermediates (produced by installer/build-installer.ps1)
Coclico.Installer/payload.zip
Coclico.Installer/uninstaller.bin

# Local backups (git history is the backup)
*.backup
*.bak

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.py[cod]

# AI Model (large binary, not in repo)
resource/model/*.gguf
resource/model/*.bin

# Coclico user data (generated at runtime)
AppData/
**/Coclico/logs/
**/Coclico/cache/
**/Coclico/audit/
**/Coclico/errors/
**/Coclico/settings.json

# Sensitive
*.pfx
*.p12
secrets.json
appsettings.Development.json

# Worktrees
.worktrees/
